{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mutation-guided-evals/schemas/run-result.schema.json",
  "title": "RunResult",
  "description": "Resultado de um run (módulo, condição, repetição). Ver PROTOCOL.md seções 5 e 10.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "finished_at",
    "subject",
    "condition",
    "repetition",
    "model",
    "tooling",
    "iterations",
    "selected_iteration",
    "final",
    "guardrails",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "description": "Formato sugerido: <biblioteca>__<modulo>__<condicao>__r<rep>",
      "pattern": "^[A-Za-z0-9._-]+__[A-Za-z0-9._/-]+__(C0|C0-suite|C1|C2|C2r|C3)__r[0-9]+$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "invalid_all_iterations",
        "budget_exhausted",
        "provider_error",
        "stryker_error",
        "timeout"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "library",
        "repo",
        "commit",
        "license",
        "module_path",
        "module_loc",
        "mutants_total"
      ],
      "additionalProperties": false,
      "properties": {
        "library": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": {
          "type": "string"
        },
        "module_path": {
          "type": "string"
        },
        "module_loc": {
          "type": "integer",
          "minimum": 1
        },
        "mutants_total": {
          "type": "integer",
          "minimum": 0
        },
        "human_test_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "condition": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C2r",
        "C3"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 0,
      "description": "0 para C0 (determinístico)"
    },
    "model": {
      "type": [
        "object",
        "null"
      ],
      "description": "null para C0",
      "required": [
        "provider",
        "model_id",
        "temperature",
        "max_output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model_id": {
          "type": "string",
          "description": "ID exato devolvido pela API"
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_output_tokens": {
          "type": "integer"
        },
        "sdk_version": {
          "type": "string"
        }
      }
    },
    "tooling": {
      "type": "object",
      "required": [
        "node",
        "vitest",
        "stryker",
        "split_seed",
        "claude_md_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string"
        },
        "vitest": {
          "type": "string"
        },
        "stryker": {
          "type": "string"
        },
        "stryker_config_sha256": {
          "type": "string"
        },
        "split_seed": {
          "type": "string"
        },
        "claude_md_sha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "null em C0 e C1"
        },
        "git_sha_agent": {
          "type": "string",
          "description": "commit do repositório do agente"
        }
      }
    },
    "memorization": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "probe_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stratum": {
          "enum": [
            "low",
            "high"
          ]
        }
      }
    },
    "iterations": {
      "type": "array",
      "minItems": 1,
      "description": "Uma entrada por k. C0: k=0 apenas. C1/C2: k=0. C2r e C3: k=0..N.",
      "items": {
        "$ref": "#/$defs/iteration"
      }
    },
    "selected_iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "k do arquivo final: maior ms_feedback (empate: menor k). C0, C1, C2: 0."
    },
    "final": {
      "type": "object",
      "description": "Métricas do arquivo final selecionado, mais custos acumulados do run inteiro.",
      "required": [
        "scores",
        "coverage",
        "cost",
        "tests"
      ],
      "additionalProperties": false,
      "properties": {
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "tests": {
          "$ref": "#/$defs/tests"
        },
        "gap_cov_ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "line_cov − ms_all, em pontos percentuais"
        },
        "valid_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tokens_per_pp": {
          "type": [
            "number",
            "null"
          ],
          "description": "tokens acumulados / ganho de ms_eval vs k=0; null se ganho ≤ 0"
        }
      }
    },
    "guardrails": {
      "type": "object",
      "required": [
        "src_diff_empty",
        "forbidden_patterns_found",
        "flaky"
      ],
      "additionalProperties": false,
      "properties": {
        "src_diff_empty": {
          "type": "boolean"
        },
        "forbidden_patterns_found": {
          "type": "array",
          "items": {
            "enum": [
              "skip",
              "todo",
              "only",
              "expect_true",
              "tautology",
              "no_assertion",
              "forbidden_import",
              "network",
              "clock",
              "random"
            ]
          }
        },
        "flaky": {
          "type": "boolean"
        },
        "reruns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_dir": {
          "type": "string"
        },
        "stryker_report": {
          "type": "string"
        },
        "final_test_file": {
          "type": "string"
        }
      }
    },
    "c0_scope": {
      "enum": [
        "module",
        "suite"
      ],
      "description": "Só em C0: 'module' usa os testes humanos do módulo; 'suite' usa toda a suíte do repositório (sensibilidade)."
    }
  },
  "$defs": {
    "scores": {
      "type": "object",
      "required": [
        "ms_eval",
        "ms_feedback",
        "ms_all"
      ],
      "additionalProperties": false,
      "properties": {
        "ms_eval": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ms_feedback": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ms_all": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ms_covered": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ms_killable": {
          "type": [
            "number",
            "null"
          ],
          "description": "Preenchido em pós-processamento, depois de todos os runs."
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "line_cov",
        "branch_cov"
      ],
      "additionalProperties": false,
      "properties": {
        "line_cov": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "branch_cov": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "calls",
        "tokens_in",
        "tokens_out",
        "usd_ref",
        "wall_s"
      ],
      "additionalProperties": false,
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "repair_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "usd_ref": {
          "type": "number",
          "minimum": 0
        },
        "wall_s": {
          "type": "number",
          "minimum": 0
        },
        "stryker_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tests": {
      "type": "object",
      "required": [
        "n_tests",
        "n_asserts"
      ],
      "additionalProperties": false,
      "properties": {
        "n_tests": {
          "type": "integer",
          "minimum": 0
        },
        "n_asserts": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "mutant_counts": {
      "type": "object",
      "required": [
        "killed",
        "survived",
        "no_coverage",
        "timeout",
        "compile_error",
        "runtime_error",
        "ignored"
      ],
      "additionalProperties": false,
      "properties": {
        "killed": {
          "type": "integer",
          "minimum": 0
        },
        "survived": {
          "type": "integer",
          "minimum": 0
        },
        "no_coverage": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "compile_error": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_error": {
          "type": "integer",
          "minimum": 0
        },
        "ignored": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "iteration": {
      "type": "object",
      "required": [
        "k",
        "valid",
        "scores",
        "coverage",
        "cost_cumulative",
        "tests"
      ],
      "additionalProperties": false,
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "boolean",
          "description": "false se a tentativa foi descartada (testes falham no original após reparos, ou guardrail violado)."
        },
        "discard_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "tests_fail_on_original",
            "guardrail_violation",
            "provider_error",
            "unparseable_response",
            "stryker_error",
            null
          ]
        },
        "repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "mutants_eval": {
          "$ref": "#/$defs/mutant_counts"
        },
        "mutants_feedback": {
          "$ref": "#/$defs/mutant_counts"
        },
        "survivors_sent": {
          "type": "integer",
          "minimum": 0,
          "description": "Nº de sobreviventes do grupo feedback incluídos no prompt desta iteração (C3, k ≥ 1)."
        },
        "survivor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Chaves (arquivo:linha:coluna:mutator:replacement) dos sobreviventes enviados."
        },
        "cost_cumulative": {
          "$ref": "#/$defs/cost"
        },
        "tests": {
          "$ref": "#/$defs/tests"
        },
        "prompt_file": {
          "type": "string"
        },
        "response_file": {
          "type": "string"
        },
        "best_k_so_far": {
          "type": [
            "integer",
            "null"
          ],
          "description": "k da melhor iteração válida (maior ms_feedback) até aqui; base das curvas de H3 em C3 e C2r."
        }
      }
    }
  }
}