z=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":3.703830999999809,"killedBy":["19"],"coveredBy":["19","20","21"],"location":{"end":{"column":42,"line":134},"start":{"column":20,"line":134}}},{"id":"76","mutatorName":"ArrowFunction","replacement":"() => undefined","statusReason":"expected '' to be 'foo=bar&baz=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":3.8093559999997524,"killedBy":["19"],"coveredBy":["19","20","21"],"location":{"end":{"column":45,"line":135},"start":{"column":10,"line":135}}},{"id":"77","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected 'foo=barbaz=qux' to be 'foo=bar&baz=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":3.799622000000454,"killedBy":["19"],"coveredBy":["19","20","21"],"location":{"end":{"column":14,"line":137},"start":{"column":11,"line":137}}}],"source":"import {\n  decodeQueryKey,\n  decodeQueryValue,\n  encodeQueryKey,\n  encodeQueryValue,\n} from \"./encoding\";\n\nexport type QueryValue =\n  | string\n  | number\n  | undefined\n  | null\n  | boolean\n  | Array<QueryValue>\n  | Record<string, any>;\n\nexport type QueryObject = Record<string, QueryValue | QueryValue[]>;\n\nexport type ParsedQuery = Record<string, string | string[]>;\n\n// const EmptyObject = /* @__PURE__ */ (() => {\n//   const C = function () {};\n//   C.prototype = Object.create(null);\n//   return C;\n// })() as unknown as { new (): any };\n\n/**\n * Parses and decodes a query string into an object.\n *\n * The input can be a query string with or without the leading `?`.\n *\n * @example\n *\n * ```js\n * parseQuery(\"?foo=bar&baz=qux\");\n * // { foo: \"bar\", baz: \"qux\" }\n *\n * parseQuery(\"tags=javascript&tags=web&tags=dev\");\n * // { tags: [\"javascript\", \"web\", \"dev\"] }\n * ```\n *\n * @note\n * The `__proto__` and `constructor` keys are ignored to prevent prototype pollution.\n *\n * @group Query_utils\n */\nexport function parseQuery<T extends ParsedQuery = ParsedQuery>(\n  parametersString = \"\",\n): T {\n  // TODO: Use new EmptyObject() instead of Object.create(null) for better performance in next major version\n  // https://github.com/unjs/ufo/pull/290\n  const object: ParsedQuery = Object.create(null);\n  if (parametersString[0] === \"?\") {\n    parametersString = parametersString.slice(1);\n  }\n  for (const parameter of parametersString.split(\"&\")) {\n    const s = parameter.match(/([^=]+)=?(.*)/) || [];\n    if (s.length < 2) {\n      continue;\n    }\n    const key = decodeQueryKey(s[1]);\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n    const value = decodeQueryValue(s[2] || \"\");\n    if (object[key] === undefined) {\n      object[key] = value;\n    } else if (Array.isArray(object[key])) {\n      (object[key] as string[]).push(value);\n    } else {\n      object[key] = [object[key] as string, value];\n    }\n  }\n  return object as T;\n}\n\n/**\n * Encodes a pair of key and value into a url query string value.\n *\n * If the value is an array, it will be encoded as multiple key-value pairs with the same key.\n *\n * @example\n *\n * ```js\n * encodeQueryItem('message', 'Hello World')\n * // 'message=Hello+World'\n *\n * encodeQueryItem('tags', ['javascript', 'web', 'dev'])\n * // 'tags=javascript&tags=web&tags=dev'\n * ```\n *\n * @group Query_utils\n */\nexport function encodeQueryItem(\n  key: string,\n  value: QueryValue | QueryValue[],\n): string {\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    value = String(value);\n  }\n  if (!value) {\n    return encodeQueryKey(key);\n  }\n\n  if (Array.isArray(value)) {\n    return value\n      .map(\n        (_value: QueryValue) =>\n          `${encodeQueryKey(key)}=${encodeQueryValue(_value)}`,\n      )\n      .join(\"&\");\n  }\n\n  return `${encodeQueryKey(key)}=${encodeQueryValue(value)}`;\n}\n\n/**\n * Stringfies and encodes a query object into a query string.\n *\n * @example\n *\n * ```js\n * stringifyQuery({ foo: 'bar', baz: 'qux' })\n * // 'foo=bar&baz=qux'\n *\n * stringifyQuery({ foo: 'bar', baz: undefined })\n * // 'foo=bar'\n * ```\n *\n * @group Query_utils\n */\nexport function stringifyQuery(query: QueryObject): string {\n  return Object.keys(query)\n    .filter((k) => query[k] !== undefined)\n    .map((k) => encodeQueryItem(k, query[k]))\n    .filter(Boolean)\n    .join(\"&\");\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/query.gen.test.ts":{"tests":[{"id":"0","name":"parseQuery should parse '' correctly","location":{"start":{"column":5,"line":14}}},{"id":"1","name":"parseQuery should parse '?foo=bar&baz=qux' correctly","location":{"start":{"column":5,"line":14}}},{"id":"2","name":"parseQuery should parse 'foo=bar&baz=qux' correctly","location":{"start":{"column":5,"line":14}}},{"id":"3","name":"parseQuery should parse 'tags=javascript&tags=web&tags=dev' correctly","location":{"start":{"column":5,"line":14}}},{"id":"4","name":"parseQuery should parse 'foo' correctly","location":{"start":{"column":5,"line":14}}},{"id":"5","name":"parseQuery should parse 'foo=' correctly","location":{"start":{"column":5,"line":14}}},{"id":"6","name":"parseQuery should parse '?' correctly","location":{"start":{"column":5,"line":14}}},{"id":"7","name":"parseQuery should parse 'foo=bar&__proto__=polluted&constructo…' correctly","location":{"start":{"column":5,"line":14}}},{"id":"8","name":"parseQuery should handle default parameter string when omitted","location":{"start":{"column":3,"line":19}}},{"id":"9","name":"parseQuery should ignore invalid query parameters that do not contain an assignment or key","location":{"start":{"column":3,"line":24}}},{"id":"10","name":"parseQuery should ignore empty parameter strings that result in length 2 array from match","location":{"start":{"column":3,"line":29}}},{"id":"11","name":"encodeQueryItem should encode query item for key 'message'","location":{"start":{"column":5,"line":44}}},{"id":"12","name":"encodeQueryItem should encode query item for key 'tags'","location":{"start":{"column":5,"line":44}}},{"id":"13","name":"encodeQueryItem should encode query item for key 'count'","location":{"start":{"column":5,"line":44}}},{"id":"14","name":"encodeQueryItem should encode query item for key 'active'","location":{"start":{"column":5,"line":44}}},{"id":"15","name":"encodeQueryItem should encode query item for key 'empty'","location":{"start":{"column":5,"line":44}}},{"id":"16","name":"encodeQueryItem should encode query item for key 'missing'","location":{"start":{"column":5,"line":44}}},{"id":"17","name":"encodeQueryItem should correctly encode number values including zero","location":{"start":{"column":3,"line":49}}},{"id":"18","name":"encodeQueryItem should correctly encode boolean false values","location":{"start":{"column":3,"line":54}}},{"id":"19","name":"stringifyQuery should stringify query object correctly","location":{"start":{"column":5,"line":66}}},{"id":"20","name":"stringifyQuery should filter out falsy stringified items from query string","location":{"start":{"column":3,"line":71}}},{"id":"21","name":"stringifyQuery should filter out empty string results when encoding items","location":{"start":{"column":3,"line":76}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { parseQuery, encodeQueryItem, stringifyQuery } from \"../../src/query\";\n\ndescribe(\"parseQuery\", () => {\n  it.each([\n    { input: \"\", expected: {} },\n    { input: \"?foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n    { input: \"foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n    { input: \"tags=javascript&tags=web&tags=dev\", expected: { tags: [\"javascript\", \"web\", \"dev\"] } },\n    { input: \"foo\", expected: { foo: \"\" } },\n    { input: \"foo=\", expected: { foo: \"\" } },\n    { input: \"?\", expected: {} },\n    { input: \"foo=bar&__proto__=polluted&constructor=bad\", expected: { foo: \"bar\" } },\n  ])(\"should parse $input correctly\", ({ input, expected }) => {\n    const result = parseQuery(input);\n    expect(result).toEqual(expected);\n  });\n\n  it(\"should handle default parameter string when omitted\", () => {\n    const result = parseQuery();\n    expect(result).toEqual({});\n  });\n\n  it(\"should ignore invalid query parameters that do not contain an assignment or key\", () => {\n    const result = parseQuery(\"foo=bar&&baz=qux\");\n    expect(result).toEqual({ foo: \"bar\", baz: \"qux\" });\n  });\n\n  it(\"should ignore empty parameter strings that result in length 2 array from match\", () => {\n    // Detects mutation where fallback array `[]` is replaced with `[\"Stryker was here\"]` (length >= 2)\n    const result = parseQuery(\"&\");\n    expect(result).toEqual({});\n  });\n});\n\ndescribe(\"encodeQueryItem\", () => {\n  it.each([\n    { key: \"message\", value: \"Hello World\", expected: \"message=Hello+World\" },\n    { key: \"tags\", value: [\"javascript\", \"web\", \"dev\"], expected: \"tags=javascript&tags=web&tags=dev\" },\n    { key: \"count\", value: 42, expected: \"count=42\" },\n    { key: \"active\", value: true, expected: \"active=true\" },\n    { key: \"empty\", value: \"\", expected: \"empty\" },\n    { key: \"missing\", value: undefined, expected: \"missing\" },\n  ])(\"should encode query item for key $key\", ({ key, value, expected }) => {\n    const result = encodeQueryItem(key, value);\n    expect(result).toBe(expected);\n  });\n\n  it(\"should correctly encode number values including zero\", () => {\n    const result = encodeQueryItem(\"score\", 0);\n    expect(result).toBe(\"score=0\");\n  });\n\n  it(\"should correctly encode boolean false values\", () => {\n    const result = encodeQueryItem(\"active\", false);\n    expect(result).toBe(\"active=false\");\n  });\n});\n\ndescribe(\"stringifyQuery\", () => {\n  it.each([\n    { input: { foo: \"bar\", baz: \"qux\" }, expected: \"foo=bar&baz=qux\" },\n    { input: { foo: \"bar\", baz: undefined }, expected: \"foo=bar\" },\n    { input: { tags: [\"javascript\", \"web\", \"dev\"] }, expected: \"tags=javascript&tags=web&tags=dev\" },\n    { input: {}, expected: \"\" },\n  ])(\"should stringify query object correctly\", ({ input, expected }) => {\n    const result = stringifyQuery(input);\n    expect(result).toBe(expected);\n  });\n\n  it(\"should filter out falsy stringified items from query string\", () => {\n    const result = stringifyQuery({ foo: \"\", bar: undefined });\n    expect(result).toBe(\"foo\");\n  });\n\n  it(\"should filter out empty string results when encoding items\", () => {\n    // Detects mutation where .filter(Boolean) is removed from stringifyQuery\n    const result = stringifyQuery({ \"\": undefined, foo: \"bar\" });\n    expect(result).toBe(\"foo=bar\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/query.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/ufo__query__C3__r1/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true,"pool":"threads"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"inc