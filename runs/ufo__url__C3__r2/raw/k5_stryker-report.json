ion":6.434020000000601,"killedBy":["8"],"coveredBy":["8"],"location":{"end":{"column":4,"line":136},"start":{"column":20,"line":134}}},{"id":"91","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'https://example.com/foo' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.873185999999805,"killedBy":["8"],"coveredBy":["8"],"location":{"end":{"column":4,"line":140},"start":{"column":22,"line":138}}},{"id":"92","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be an instance of $URL","status":"Killed","static":false,"testsCompleted":1,"duration":2.7944189999998343,"killedBy":["11"],"coveredBy":["11"],"location":{"end":{"column":2,"line":148},"start":{"column":48,"line":146}}}],"source":"import { parseURL, parseAuth, parseHost } from \"./parse\";\nimport { QueryObject, parseQuery, stringifyQuery } from \"./query\";\nimport { withoutLeadingSlash, withTrailingSlash } from \"./utils\";\nimport {\n  encodeHash,\n  encodePath,\n  decodePath,\n  decode,\n  encodeHost,\n} from \"./encoding\";\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport class $URL implements URL {\n  protocol: string;\n  host: string;\n  auth: string;\n  pathname: string;\n  query: QueryObject = {};\n  hash: string;\n\n  constructor(input = \"\") {\n    if (typeof input !== \"string\") {\n      throw new TypeError(\n        `URL input should be string received ${typeof input} (${input})`,\n      );\n    }\n\n    const parsed = parseURL(input);\n\n    this.protocol = decode(parsed.protocol);\n    this.host = decode(parsed.host);\n    this.auth = decode(parsed.auth);\n    this.pathname = decodePath(parsed.pathname);\n    this.query = parseQuery(parsed.search);\n    this.hash = decode(parsed.hash);\n  }\n\n  get hostname(): string {\n    return parseHost(this.host).hostname;\n  }\n\n  get port(): string {\n    return parseHost(this.host).port || \"\";\n  }\n\n  get username(): string {\n    return parseAuth(this.auth).username;\n  }\n\n  get password(): string {\n    return parseAuth(this.auth).password || \"\";\n  }\n\n  get hasProtocol() {\n    return this.protocol.length;\n  }\n\n  get isAbsolute() {\n    return this.hasProtocol || this.pathname[0] === \"/\";\n  }\n\n  get search(): string {\n    const q = stringifyQuery(this.query);\n    return q.length > 0 ? \"?\" + q : \"\";\n  }\n\n  get searchParams(): URLSearchParams {\n    const p = new URLSearchParams();\n    for (const name in this.query) {\n      const value = this.query[name];\n      if (Array.isArray(value)) {\n        for (const v of value) {\n          p.append(name, v);\n        }\n      } else {\n        p.append(\n          name,\n          typeof value === \"string\" ? value : JSON.stringify(value),\n        );\n      }\n    }\n    return p;\n  }\n\n  get origin(): string {\n    return (this.protocol ? this.protocol + \"//\" : \"\") + encodeHost(this.host);\n  }\n\n  get fullpath(): string {\n    return encodePath(this.pathname) + this.search + encodeHash(this.hash);\n  }\n\n  get encodedAuth(): string {\n    if (!this.auth) {\n      return \"\";\n    }\n    const { username, password } = parseAuth(this.auth);\n    return (\n      encodeURIComponent(username) +\n      (password ? \":\" + encodeURIComponent(password) : \"\")\n    );\n  }\n\n  get href(): string {\n    const auth = this.encodedAuth;\n    const originWithAuth =\n      (this.protocol ? this.protocol + \"//\" : \"\") +\n      (auth ? auth + \"@\" : \"\") +\n      encodeHost(this.host);\n    return this.hasProtocol && this.isAbsolute\n      ? originWithAuth + this.fullpath\n      : this.fullpath;\n  }\n\n  append(url: $URL) {\n    if (url.hasProtocol) {\n      throw new Error(\"Cannot append a URL with protocol\");\n    }\n\n    Object.assign(this.query, url.query);\n\n    if (url.pathname) {\n      this.pathname =\n        withTrailingSlash(this.pathname) + withoutLeadingSlash(url.pathname);\n    }\n\n    if (url.hash) {\n      this.hash = url.hash;\n    }\n  }\n\n  toJSON(): string {\n    return this.href;\n  }\n\n  toString(): string {\n    return this.href;\n  }\n}\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport function createURL(input: string): $URL {\n  return new $URL(input);\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/url.gen.test.ts":{"tests":[{"id":"0","name":"$URL should parse absolute URL correctly","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"$URL should parse relative URL correctly","location":{"start":{"column":3,"line":21}}},{"id":"2","name":"$URL should handle empty input with default value","location":{"start":{"column":3,"line":33}}},{"id":"3","name":"$URL should throw TypeError on invalid input type","location":{"start":{"column":3,"line":39}}},{"id":"4","name":"$URL should parse host with port","location":{"start":{"column":3,"line":46}}},{"id":"5","name":"$URL should parse username and password from auth","location":{"start":{"column":3,"line":53}}},{"id":"6","name":"$URL should provide searchParams correctly","location":{"start":{"column":3,"line":60}}},{"id":"7","name":"$URL should handle array values in query and searchParams","location":{"start":{"column":3,"line":67}}},{"id":"8","name":"$URL should serialize to JSON and string","location":{"start":{"column":3,"line":73}}},{"id":"9","name":"$URL append should append query, pathname and hash","location":{"start":{"column":5,"line":80}}},{"id":"10","name":"$URL append should throw error when appending a URL with protocol","location":{"start":{"column":5,"line":91}}},{"id":"11","name":"createURL should create a $URL instance","location":{"start":{"column":3,"line":101}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { $URL, createURL } from \"../../src/url\";\n\ndescribe(\"$URL\", () => {\n  it(\"should parse absolute URL correctly\", () => {\n    const url = new $URL(\"https://example.com/path?foo=bar#hash\");\n    expect(url.protocol).toBe(\"https:\");\n    expect(url.host).toBe(\"example.com\");\n    expect(url.pathname).toBe(\"/path\");\n    expect(url.query).toEqual({ foo: \"bar\" });\n    expect(url.hash).toBe(\"#hash\");\n    expect(url.hostname).toBe(\"example.com\");\n    expect(url.port).toBe(\"\");\n    expect(url.hasProtocol).toBe(6);\n    expect(url.isAbsolute).toBe(6);\n    expect(url.search).toBe(\"?foo=bar\");\n    expect(url.origin).toBe(\"https://example.com\");\n    expect(url.href).toBe(\"https://example.com/path?foo=bar#hash\");\n  });\n\n  it(\"should parse relative URL correctly\", () => {\n    const url = new $URL(\"/foo/bar?a=1\");\n    expect(url.protocol).toBe(\"\");\n    expect(url.host).toBe(\"\");\n    expect(url.pathname).toBe(\"/foo/bar\");\n    expect(url.query).toEqual({ a: \"1\" });\n    expect(url.hash).toBe(\"\");\n    expect(url.hasProtocol).toBe(0);\n    expect(url.isAbsolute).toBe(true);\n    expect(url.href).toBe(\"/foo/bar?a=1\");\n  });\n\n  it(\"should handle empty input with default value\", () => {\n    const url = new $URL();\n    expect(url.pathname).toBe(\"\");\n    expect(url.href).toBe(\"\");\n  });\n\n  it(\"should throw TypeError on invalid input type\", () => {\n    // @ts-expect-error testing invalid input type at runtime\n    expect(() => new $URL(123)).toThrow(TypeError);\n    // @ts-expect-error testing invalid input type at runtime\n    expect(() => new $URL(null)).toThrow(\"URL input should be string received object (null)\");\n  });\n\n  it(\"should parse host with port\", () => {\n    const url = new $URL(\"http://localhost:3000/test\");\n    expect(url.hostname).toBe(\"localhost\");\n    expect(url.port).toBe(\"3000\");\n    expect(url.origin).toBe(\"http://localhost:3000\");\n  });\n\n  it(\"should parse username and password from auth\", () => {\n    const url = new $URL(\"https://user:pass@example.com/\");\n    expect(url.username).toBe(\"user\");\n    expect(url.password).toBe(\"pass\");\n    expect(url.encodedAuth).toBe(\"user:pass\");\n  });\n\n  it(\"should provide searchParams correctly\", () => {\n    const url = new $URL(\"https://example.com/?a=1&b=2\");\n    const params = url.searchParams;\n    expect(params.get(\"a\")).toBe(\"1\");\n    expect(params.get(\"b\")).toBe(\"2\");\n  });\n\n  it(\"should handle array values in query and searchParams\", () => {\n    const url = new $URL(\"https://example.com/?tag=a&tag=b\");\n    expect(url.query).toEqual({ tag: [\"a\", \"b\"] });\n    expect(url.searchParams.getAll(\"tag\")).toEqual([\"a\", \"b\"]);\n  });\n\n  it(\"should serialize to JSON and string\", () => {\n    const url = new $URL(\"https://example.com/foo\");\n    expect(url.toJSON()).toBe(\"https://example.com/foo\");\n    expect(url.toString()).toBe(\"https://example.com/foo\");\n  });\n\n  describe(\"append\", () => {\n    it(\"should append query, pathname and hash\", () => {\n      const base = new $URL(\"https://example.com/base?a=1\");\n      const other = new $URL(\"/path?b=2#newhash\");\n\n      base.append(other);\n      expect(base.pathname).toBe(\"/base/path\");\n      expect(base.query).toEqual({ a: \"1\", b: \"2\" });\n      expect(base.hash).toBe(\"#newhash\");\n      expect(base.href).toBe(\"https://example.com/base/path?a=1&b=2#newhash\");\n    });\n\n    it(\"should throw error when appending a URL with protocol\", () => {\n      const base = new $URL(\"https://example.com/\");\n      const other = new $URL(\"https://other.com/\");\n\n      expect(() => base.append(other)).toThrow(\"Cannot append a URL with protocol\");\n    });\n  });\n});\n\ndescribe(\"createURL\", () => {\n  it(\"should create a $URL instance\", () => {\n    const url = createURL(\"https://example.com/test\");\n    expect(url).toBeInstanceOf($URL);\n    expect(url.href).toBe(\"https://example.com/test\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","co