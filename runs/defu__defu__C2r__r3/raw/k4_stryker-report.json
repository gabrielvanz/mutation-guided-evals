ason":"expected { items: [Function items] } to deeply equal { items: [ 'a', 'b', 'c' ] }","status":"Killed","static":false,"testsCompleted":1,"duration":5.302534000000378,"killedBy":["10"],"coveredBy":["10"],"location":{"end":{"column":16,"line":67},"start":{"column":12,"line":67}}},{"id":"43","mutatorName":"BlockStatement","replacement":"{}","statusReason":"default is not a function","status":"Killed","static":true,"testsCompleted":1,"duration":1.2651249999998981,"killedBy":["0"],"coveredBy":["7"],"location":{"end":{"column":2,"line":49},"start":{"column":59,"line":45}}},{"id":"44","mutatorName":"ArrowFunction","replacement":"() => undefined","statusReason":"expected undefined to deeply equal { a: 1, b: 3 }","status":"Killed","static":true,"testsCompleted":1,"duration":3.597671000000446,"killedBy":["0"],"coveredBy":["7"],"location":{"end":{"column":68,"line":48},"start":{"column":10,"line":46}}}],"source":"import { isPlainObject } from \"./_utils\";\nimport type { Merger, DefuFn as DefuFunction, DefuInstance } from \"./types\";\n\n// Base function to apply defaults\nfunction _defu<T>(baseObject: T, defaults: any, namespace = \".\", merger?: Merger): T {\n  if (!isPlainObject(defaults)) {\n    return _defu(baseObject, {}, namespace, merger);\n  }\n\n  const object = { ...defaults };\n\n  for (const key of Object.keys(baseObject as Record<string, any>)) {\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n\n    const value = (baseObject as Record<string, any>)[key];\n\n    if (value === null || value === undefined) {\n      continue;\n    }\n\n    if (merger && merger(object, key, value, namespace)) {\n      continue;\n    }\n\n    if (Array.isArray(value) && Array.isArray(object[key])) {\n      object[key] = [...value, ...object[key]];\n    } else if (isPlainObject(value) && isPlainObject(object[key])) {\n      object[key] = _defu(\n        value,\n        object[key],\n        (namespace ? `${namespace}.` : \"\") + key.toString(),\n        merger,\n      );\n    } else {\n      object[key] = value;\n    }\n  }\n\n  return object;\n}\n\n// Create defu wrapper with optional merger and multi arg support\nexport function createDefu(merger?: Merger): DefuFunction {\n  return (...arguments_) =>\n    // eslint-disable-next-line unicorn/no-array-reduce\n    arguments_.reduce((p, c) => _defu(p, c, \"\", merger), {} as any);\n}\n\n// Standard version\nexport const defu = createDefu() as DefuInstance;\nexport default defu;\n\n// Custom version with function merge support\nexport const defuFn = createDefu((object, key, currentValue) => {\n  if (object[key] !== undefined && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\n// Custom version with function merge support only for defined arrays\nexport const defuArrayFn = createDefu((object, key, currentValue) => {\n  if (Array.isArray(object[key]) && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\nexport type { Defu, DefuFn, DefuInstance } from \"./types\";\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/defu.gen.test.ts":{"tests":[{"id":"0","name":"defu should merge basic objects with defaults","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"defu should merge multiple objects in order of precedence","location":{"start":{"column":3,"line":10}}},{"id":"2","name":"defu should ignore undefined or null values in base object","location":{"start":{"column":3,"line":15}}},{"id":"3","name":"defu should concatenate arrays","location":{"start":{"column":3,"line":20}}},{"id":"4","name":"defu should recursively merge nested plain objects","location":{"start":{"column":3,"line":25}}},{"id":"5","name":"defu should ignore prototype pollution keys","location":{"start":{"column":3,"line":36}}},{"id":"6","name":"defu should handle non-plain object defaults gracefully","location":{"start":{"column":3,"line":43}}},{"id":"7","name":"createDefu should create a custom defu instance with a custom merger","location":{"start":{"column":3,"line":50}}},{"id":"8","name":"defuFn should execute functions when merging with existing values","location":{"start":{"column":3,"line":64}}},{"id":"9","name":"defuFn should not execute function if default value is undefined","location":{"start":{"column":3,"line":76}}},{"id":"10","name":"defuArrayFn should execute function only when default value is an array","location":{"start":{"column":3,"line":84}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport defu, { createDefu, defuFn, defuArrayFn } from \"../../src/defu\";\n\ndescribe(\"defu\", () => {\n  it(\"should merge basic objects with defaults\", () => {\n    const result = defu({ a: 1 }, { a: 2, b: 3 });\n    expect(result).toEqual({ a: 1, b: 3 });\n  });\n\n  it(\"should merge multiple objects in order of precedence\", () => {\n    const result = defu({ a: 1 }, { a: 2, b: 2 }, { b: 3, c: 4 });\n    expect(result).toEqual({ a: 1, b: 2, c: 4 });\n  });\n\n  it(\"should ignore undefined or null values in base object\", () => {\n    const result = defu({ a: undefined, b: null }, { a: 1, b: 2, c: 3 });\n    expect(result).toEqual({ a: 1, b: 2, c: 3 });\n  });\n\n  it(\"should concatenate arrays\", () => {\n    const result = defu({ a: [1, 2] }, { a: [3, 4] });\n    expect(result).toEqual({ a: [1, 2, 3, 4] });\n  });\n\n  it(\"should recursively merge nested plain objects\", () => {\n    const result = defu(\n      { a: { x: 1, y: 2 } },\n      { a: { y: 20, z: 30 }, b: 40 }\n    );\n    expect(result).toEqual({\n      a: { x: 1, y: 2, z: 30 },\n      b: 40,\n    });\n  });\n\n  it(\"should ignore prototype pollution keys\", () => {\n    const payload = JSON.parse('{\"__proto__\": {\"polluted\": true}, \"constructor\": {\"prototype\": {\"polluted\": true}}, \"a\": 1}');\n    const result = defu(payload, { a: 2, b: 3 });\n    expect(result).toEqual({ a: 1, b: 3 });\n    expect(({} as any).polluted).toBeUndefined();\n  });\n\n  it(\"should handle non-plain object defaults gracefully\", () => {\n    const result = defu({ a: 1 }, null as any);\n    expect(result).toEqual({ a: 1 });\n  });\n});\n\ndescribe(\"createDefu\", () => {\n  it(\"should create a custom defu instance with a custom merger\", () => {\n    const customDefu = createDefu((object, key, currentValue) => {\n      if (key === \"special\") {\n        object[key] = `custom_${currentValue}`;\n        return true;\n      }\n    });\n\n    const result = customDefu({ special: \"value\" }, { special: \"default\" });\n    expect(result).toEqual({ special: \"custom_value\" });\n  });\n});\n\ndescribe(\"defuFn\", () => {\n  it(\"should execute functions when merging with existing values\", () => {\n    const result = defuFn(\n      {\n        port: (val: number) => val + 1000,\n      },\n      {\n        port: 3000,\n      }\n    );\n    expect(result).toEqual({ port: 4000 });\n  });\n\n  it(\"should not execute function if default value is undefined\", () => {\n    const fn = (val: number) => val + 1;\n    const result = defuFn({ port: fn }, {});\n    expect(result).toEqual({ port: fn });\n  });\n});\n\ndescribe(\"defuArrayFn\", () => {\n  it(\"should execute function only when default value is an array\", () => {\n    const result = defuArrayFn(\n      {\n        items: (val: string[]) => [...val, \"c\"],\n      },\n      {\n        items: [\"a\", \"b\"],\n      }\n    );\n    expect(result).toEqual({ items: [\"a\", \"b\", \"c\"] });\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/defu","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/defu.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/defu__defu__C2r__r3/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true