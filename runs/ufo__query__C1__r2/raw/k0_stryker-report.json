&baz=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.758073999999397,"killedBy":["7"],"coveredBy":["7","8","9"],"location":{"end":{"column":14,"line":137},"start":{"column":11,"line":137}}}],"source":"import {\n  decodeQueryKey,\n  decodeQueryValue,\n  encodeQueryKey,\n  encodeQueryValue,\n} from \"./encoding\";\n\nexport type QueryValue =\n  | string\n  | number\n  | undefined\n  | null\n  | boolean\n  | Array<QueryValue>\n  | Record<string, any>;\n\nexport type QueryObject = Record<string, QueryValue | QueryValue[]>;\n\nexport type ParsedQuery = Record<string, string | string[]>;\n\n// const EmptyObject = /* @__PURE__ */ (() => {\n//   const C = function () {};\n//   C.prototype = Object.create(null);\n//   return C;\n// })() as unknown as { new (): any };\n\n/**\n * Parses and decodes a query string into an object.\n *\n * The input can be a query string with or without the leading `?`.\n *\n * @example\n *\n * ```js\n * parseQuery(\"?foo=bar&baz=qux\");\n * // { foo: \"bar\", baz: \"qux\" }\n *\n * parseQuery(\"tags=javascript&tags=web&tags=dev\");\n * // { tags: [\"javascript\", \"web\", \"dev\"] }\n * ```\n *\n * @note\n * The `__proto__` and `constructor` keys are ignored to prevent prototype pollution.\n *\n * @group Query_utils\n */\nexport function parseQuery<T extends ParsedQuery = ParsedQuery>(\n  parametersString = \"\",\n): T {\n  // TODO: Use new EmptyObject() instead of Object.create(null) for better performance in next major version\n  // https://github.com/unjs/ufo/pull/290\n  const object: ParsedQuery = Object.create(null);\n  if (parametersString[0] === \"?\") {\n    parametersString = parametersString.slice(1);\n  }\n  for (const parameter of parametersString.split(\"&\")) {\n    const s = parameter.match(/([^=]+)=?(.*)/) || [];\n    if (s.length < 2) {\n      continue;\n    }\n    const key = decodeQueryKey(s[1]);\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n    const value = decodeQueryValue(s[2] || \"\");\n    if (object[key] === undefined) {\n      object[key] = value;\n    } else if (Array.isArray(object[key])) {\n      (object[key] as string[]).push(value);\n    } else {\n      object[key] = [object[key] as string, value];\n    }\n  }\n  return object as T;\n}\n\n/**\n * Encodes a pair of key and value into a url query string value.\n *\n * If the value is an array, it will be encoded as multiple key-value pairs with the same key.\n *\n * @example\n *\n * ```js\n * encodeQueryItem('message', 'Hello World')\n * // 'message=Hello+World'\n *\n * encodeQueryItem('tags', ['javascript', 'web', 'dev'])\n * // 'tags=javascript&tags=web&tags=dev'\n * ```\n *\n * @group Query_utils\n */\nexport function encodeQueryItem(\n  key: string,\n  value: QueryValue | QueryValue[],\n): string {\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    value = String(value);\n  }\n  if (!value) {\n    return encodeQueryKey(key);\n  }\n\n  if (Array.isArray(value)) {\n    return value\n      .map(\n        (_value: QueryValue) =>\n          `${encodeQueryKey(key)}=${encodeQueryValue(_value)}`,\n      )\n      .join(\"&\");\n  }\n\n  return `${encodeQueryKey(key)}=${encodeQueryValue(value)}`;\n}\n\n/**\n * Stringfies and encodes a query object into a query string.\n *\n * @example\n *\n * ```js\n * stringifyQuery({ foo: 'bar', baz: 'qux' })\n * // 'foo=bar&baz=qux'\n *\n * stringifyQuery({ foo: 'bar', baz: undefined })\n * // 'foo=bar'\n * ```\n *\n * @group Query_utils\n */\nexport function stringifyQuery(query: QueryObject): string {\n  return Object.keys(query)\n    .filter((k) => query[k] !== undefined)\n    .map((k) => encodeQueryItem(k, query[k]))\n    .filter(Boolean)\n    .join(\"&\");\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/query.gen.test.ts":{"tests":[{"id":"0","name":"query parseQuery parses empty or missing strings","location":{"start":{"column":5,"line":6}}},{"id":"1","name":"query parseQuery parses query string with or without leading question mark","location":{"start":{"column":5,"line":11}}},{"id":"2","name":"query parseQuery parses multiple parameters and duplicate keys into arrays","location":{"start":{"column":5,"line":16}}},{"id":"3","name":"query parseQuery ignores __proto__ and constructor keys to prevent prototype pollution","location":{"start":{"column":5,"line":23}}},{"id":"4","name":"query encodeQueryItem encodes primitive types","location":{"start":{"column":5,"line":32}}},{"id":"5","name":"query encodeQueryItem encodes arrays as multiple key-value pairs","location":{"start":{"column":5,"line":38}}},{"id":"6","name":"query encodeQueryItem handles falsy values","location":{"start":{"column":5,"line":44}}},{"id":"7","name":"query stringifyQuery stringifies and encodes a query object","location":{"start":{"column":5,"line":50}}},{"id":"8","name":"query stringifyQuery filters out undefined values","location":{"start":{"column":5,"line":54}}},{"id":"9","name":"query stringifyQuery handles arrays and multiple item types","location":{"start":{"column":5,"line":58}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { parseQuery, encodeQueryItem, stringifyQuery } from \"../../src/query\";\n\ndescribe(\"query\", () => {\n  describe(\"parseQuery\", () => {\n    it(\"parses empty or missing strings\", () => {\n      expect(parseQuery()).toEqual({});\n      expect(parseQuery(\"\")).toEqual({});\n    });\n\n    it(\"parses query string with or without leading question mark\", () => {\n      expect(parseQuery(\"?foo=bar\")).toEqual({ foo: \"bar\" });\n      expect(parseQuery(\"foo=bar\")).toEqual({ foo: \"bar\" });\n    });\n\n    it(\"parses multiple parameters and duplicate keys into arrays\", () => {\n      expect(parseQuery(\"foo=bar&baz=qux\")).toEqual({ foo: \"bar\", baz: \"qux\" });\n      expect(parseQuery(\"tags=js&tags=web&tags=dev\")).toEqual({\n        tags: [\"js\", \"web\", \"dev\"],\n      });\n    });\n\n    it(\"ignores __proto__ and constructor keys to prevent prototype pollution\", () => {\n      const result = parseQuery(\"__proto__.foo=bar&constructor=baz&normal=val\");\n      expect(result).toHaveProperty(\"normal\", \"val\");\n      expect(result).not.toHaveProperty(\"__proto__\");\n      expect(result).not.toHaveProperty(\"constructor\");\n    });\n  });\n\n  describe(\"encodeQueryItem\", () => {\n    it(\"encodes primitive types\", () => {\n      expect(encodeQueryItem(\"message\", \"Hello World\")).toBe(\"message=Hello+World\");\n      expect(encodeQueryItem(\"count\", 42)).toBe(\"count=42\");\n      expect(encodeQueryItem(\"active\", true)).toBe(\"active=true\");\n    });\n\n    it(\"encodes arrays as multiple key-value pairs\", () => {\n      expect(encodeQueryItem(\"tags\", [\"javascript\", \"web\"])).toBe(\n        \"tags=javascript&tags=web\",\n      );\n    });\n\n    it(\"handles falsy values\", () => {\n      expect(encodeQueryItem(\"empty\", \"\")).toBe(\"empty\");\n    });\n  });\n\n  describe(\"stringifyQuery\", () => {\n    it(\"stringifies and encodes a query object\", () => {\n      expect(stringifyQuery({ foo: \"bar\", baz: \"qux\" })).toBe(\"foo=bar&baz=qux\");\n    });\n\n    it(\"filters out undefined values\", () => {\n      expect(stringifyQuery({ foo: \"bar\", baz: undefined })).toBe(\"foo=bar\");\n    });\n\n    it(\"handles arrays and multiple item types\", () => {\n      expect(\n        stringifyQuery({\n          tags: [\"js\", \"ts\"],\n          page: 1,\n        }),\n      ).toBe(\"tags=js&tags=ts&page=1\");\n    });\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/query.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/ufo__query__C1__r2/work/stryker-report.json"},"vitest":{"configFile":"v