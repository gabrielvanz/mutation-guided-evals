placement":"false","statusReason":"expected '' to be 'foo=bar&baz=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.278495000000476,"killedBy":["4"],"coveredBy":["4"],"location":{"end":{"column":42,"line":134},"start":{"column":20,"line":134}}},{"id":"76","mutatorName":"ArrowFunction","replacement":"() => undefined","statusReason":"expected '' to be 'foo=bar&baz=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.970758000000387,"killedBy":["4"],"coveredBy":["4"],"location":{"end":{"column":45,"line":135},"start":{"column":10,"line":135}}},{"id":"77","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected 'foo=barbaz=qux' to be 'foo=bar&baz=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":6.560649000000012,"killedBy":["4"],"coveredBy":["4"],"location":{"end":{"column":14,"line":137},"start":{"column":11,"line":137}}}],"source":"import {\n  decodeQueryKey,\n  decodeQueryValue,\n  encodeQueryKey,\n  encodeQueryValue,\n} from \"./encoding\";\n\nexport type QueryValue =\n  | string\n  | number\n  | undefined\n  | null\n  | boolean\n  | Array<QueryValue>\n  | Record<string, any>;\n\nexport type QueryObject = Record<string, QueryValue | QueryValue[]>;\n\nexport type ParsedQuery = Record<string, string | string[]>;\n\n// const EmptyObject = /* @__PURE__ */ (() => {\n//   const C = function () {};\n//   C.prototype = Object.create(null);\n//   return C;\n// })() as unknown as { new (): any };\n\n/**\n * Parses and decodes a query string into an object.\n *\n * The input can be a query string with or without the leading `?`.\n *\n * @example\n *\n * ```js\n * parseQuery(\"?foo=bar&baz=qux\");\n * // { foo: \"bar\", baz: \"qux\" }\n *\n * parseQuery(\"tags=javascript&tags=web&tags=dev\");\n * // { tags: [\"javascript\", \"web\", \"dev\"] }\n * ```\n *\n * @note\n * The `__proto__` and `constructor` keys are ignored to prevent prototype pollution.\n *\n * @group Query_utils\n */\nexport function parseQuery<T extends ParsedQuery = ParsedQuery>(\n  parametersString = \"\",\n): T {\n  // TODO: Use new EmptyObject() instead of Object.create(null) for better performance in next major version\n  // https://github.com/unjs/ufo/pull/290\n  const object: ParsedQuery = Object.create(null);\n  if (parametersString[0] === \"?\") {\n    parametersString = parametersString.slice(1);\n  }\n  for (const parameter of parametersString.split(\"&\")) {\n    const s = parameter.match(/([^=]+)=?(.*)/) || [];\n    if (s.length < 2) {\n      continue;\n    }\n    const key = decodeQueryKey(s[1]);\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n    const value = decodeQueryValue(s[2] || \"\");\n    if (object[key] === undefined) {\n      object[key] = value;\n    } else if (Array.isArray(object[key])) {\n      (object[key] as string[]).push(value);\n    } else {\n      object[key] = [object[key] as string, value];\n    }\n  }\n  return object as T;\n}\n\n/**\n * Encodes a pair of key and value into a url query string value.\n *\n * If the value is an array, it will be encoded as multiple key-value pairs with the same key.\n *\n * @example\n *\n * ```js\n * encodeQueryItem('message', 'Hello World')\n * // 'message=Hello+World'\n *\n * encodeQueryItem('tags', ['javascript', 'web', 'dev'])\n * // 'tags=javascript&tags=web&tags=dev'\n * ```\n *\n * @group Query_utils\n */\nexport function encodeQueryItem(\n  key: string,\n  value: QueryValue | QueryValue[],\n): string {\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    value = String(value);\n  }\n  if (!value) {\n    return encodeQueryKey(key);\n  }\n\n  if (Array.isArray(value)) {\n    return value\n      .map(\n        (_value: QueryValue) =>\n          `${encodeQueryKey(key)}=${encodeQueryValue(_value)}`,\n      )\n      .join(\"&\");\n  }\n\n  return `${encodeQueryKey(key)}=${encodeQueryValue(value)}`;\n}\n\n/**\n * Stringfies and encodes a query object into a query string.\n *\n * @example\n *\n * ```js\n * stringifyQuery({ foo: 'bar', baz: 'qux' })\n * // 'foo=bar&baz=qux'\n *\n * stringifyQuery({ foo: 'bar', baz: undefined })\n * // 'foo=bar'\n * ```\n *\n * @group Query_utils\n */\nexport function stringifyQuery(query: QueryObject): string {\n  return Object.keys(query)\n    .filter((k) => query[k] !== undefined)\n    .map((k) => encodeQueryItem(k, query[k]))\n    .filter(Boolean)\n    .join(\"&\");\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/query.gen.test.ts":{"tests":[{"id":"0","name":"parseQuery should parse basic query strings","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"parseQuery should ignore prototype pollution keys","location":{"start":{"column":3,"line":23}}},{"id":"2","name":"parseQuery should handle omitted parameters","location":{"start":{"column":3,"line":28}}},{"id":"3","name":"encodeQueryItem should encode keys and values correctly","location":{"start":{"column":3,"line":34}}},{"id":"4","name":"stringifyQuery should stringify query objects correctly","location":{"start":{"column":3,"line":52}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { parseQuery, encodeQueryItem, stringifyQuery } from \"../../src/query\";\n\ndescribe(\"parseQuery\", () => {\n  it(\"should parse basic query strings\", () => {\n    const cases = [\n      { input: \"foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n      { input: \"?foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n      { input: \"tags=javascript&tags=web&tags=dev\", expected: { tags: [\"javascript\", \"web\", \"dev\"] } },\n      { input: \"\", expected: {} },\n      { input: \"?\", expected: {} },\n      { input: \"foo=bar&foo=baz\", expected: { foo: [\"bar\", \"baz\"] } },\n      { input: \"foo=\", expected: { foo: \"\" } },\n      { input: \"foo=bar&\", expected: { foo: \"bar\" } },\n      { input: \"a=1&b=true&c=null\", expected: { a: \"1\", b: \"true\", c: \"null\" } },\n    ];\n\n    for (const { input, expected } of cases) {\n      expect(parseQuery(input)).toEqual(expected);\n    }\n  });\n\n  it(\"should ignore prototype pollution keys\", () => {\n    const input = \"__proto__=polluted&constructor=polluted&safe=val\";\n    expect(parseQuery(input)).toEqual({ safe: \"val\" });\n  });\n\n  it(\"should handle omitted parameters\", () => {\n    expect(parseQuery()).toEqual({});\n  });\n});\n\ndescribe(\"encodeQueryItem\", () => {\n  it(\"should encode keys and values correctly\", () => {\n    const cases = [\n      { key: \"message\", value: \"Hello World\", expected: \"message=Hello+World\" },\n      { key: \"tags\", value: [\"javascript\", \"web\", \"dev\"], expected: \"tags=javascript&tags=web&tags=dev\" },\n      { key: \"num\", value: 123, expected: \"num=123\" },\n      { key: \"bool\", value: true, expected: \"bool=true\" },\n      { key: \"empty\", value: \"\", expected: \"empty\" },\n      { key: \"undef\", value: undefined, expected: \"undef\" },\n      { key: \"null\", value: null, expected: \"null\" },\n    ];\n\n    for (const { key, value, expected } of cases) {\n      expect(encodeQueryItem(key, value as any)).toBe(expected);\n    }\n  });\n});\n\ndescribe(\"stringifyQuery\", () => {\n  it(\"should stringify query objects correctly\", () => {\n    const cases = [\n      { input: { foo: \"bar\", baz: \"qux\" }, expected: \"foo=bar&baz=qux\" },\n      { input: { foo: \"bar\", baz: undefined }, expected: \"foo=bar\" },\n      { input: { tags: [\"javascript\", \"web\"] }, expected: \"tags=javascript&tags=web\" },\n      { input: {}, expected: \"\" },\n      { input: { a: 1, b: false }, expected: \"a=1&b=false\" },\n    ];\n\n    for (const { input, expected } of cases) {\n      expect(stringifyQuery(input)).toBe(expected);\n    }\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest"