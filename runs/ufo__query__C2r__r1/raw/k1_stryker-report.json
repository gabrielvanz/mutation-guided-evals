tusReason":"expected 'foo=barbaz=qux' to be 'foo=bar&baz=qux' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.753560999999536,"killedBy":["15"],"coveredBy":["15"],"location":{"end":{"column":14,"line":137},"start":{"column":11,"line":137}}}],"source":"import {\n  decodeQueryKey,\n  decodeQueryValue,\n  encodeQueryKey,\n  encodeQueryValue,\n} from \"./encoding\";\n\nexport type QueryValue =\n  | string\n  | number\n  | undefined\n  | null\n  | boolean\n  | Array<QueryValue>\n  | Record<string, any>;\n\nexport type QueryObject = Record<string, QueryValue | QueryValue[]>;\n\nexport type ParsedQuery = Record<string, string | string[]>;\n\n// const EmptyObject = /* @__PURE__ */ (() => {\n//   const C = function () {};\n//   C.prototype = Object.create(null);\n//   return C;\n// })() as unknown as { new (): any };\n\n/**\n * Parses and decodes a query string into an object.\n *\n * The input can be a query string with or without the leading `?`.\n *\n * @example\n *\n * ```js\n * parseQuery(\"?foo=bar&baz=qux\");\n * // { foo: \"bar\", baz: \"qux\" }\n *\n * parseQuery(\"tags=javascript&tags=web&tags=dev\");\n * // { tags: [\"javascript\", \"web\", \"dev\"] }\n * ```\n *\n * @note\n * The `__proto__` and `constructor` keys are ignored to prevent prototype pollution.\n *\n * @group Query_utils\n */\nexport function parseQuery<T extends ParsedQuery = ParsedQuery>(\n  parametersString = \"\",\n): T {\n  // TODO: Use new EmptyObject() instead of Object.create(null) for better performance in next major version\n  // https://github.com/unjs/ufo/pull/290\n  const object: ParsedQuery = Object.create(null);\n  if (parametersString[0] === \"?\") {\n    parametersString = parametersString.slice(1);\n  }\n  for (const parameter of parametersString.split(\"&\")) {\n    const s = parameter.match(/([^=]+)=?(.*)/) || [];\n    if (s.length < 2) {\n      continue;\n    }\n    const key = decodeQueryKey(s[1]);\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n    const value = decodeQueryValue(s[2] || \"\");\n    if (object[key] === undefined) {\n      object[key] = value;\n    } else if (Array.isArray(object[key])) {\n      (object[key] as string[]).push(value);\n    } else {\n      object[key] = [object[key] as string, value];\n    }\n  }\n  return object as T;\n}\n\n/**\n * Encodes a pair of key and value into a url query string value.\n *\n * If the value is an array, it will be encoded as multiple key-value pairs with the same key.\n *\n * @example\n *\n * ```js\n * encodeQueryItem('message', 'Hello World')\n * // 'message=Hello+World'\n *\n * encodeQueryItem('tags', ['javascript', 'web', 'dev'])\n * // 'tags=javascript&tags=web&tags=dev'\n * ```\n *\n * @group Query_utils\n */\nexport function encodeQueryItem(\n  key: string,\n  value: QueryValue | QueryValue[],\n): string {\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    value = String(value);\n  }\n  if (!value) {\n    return encodeQueryKey(key);\n  }\n\n  if (Array.isArray(value)) {\n    return value\n      .map(\n        (_value: QueryValue) =>\n          `${encodeQueryKey(key)}=${encodeQueryValue(_value)}`,\n      )\n      .join(\"&\");\n  }\n\n  return `${encodeQueryKey(key)}=${encodeQueryValue(value)}`;\n}\n\n/**\n * Stringfies and encodes a query object into a query string.\n *\n * @example\n *\n * ```js\n * stringifyQuery({ foo: 'bar', baz: 'qux' })\n * // 'foo=bar&baz=qux'\n *\n * stringifyQuery({ foo: 'bar', baz: undefined })\n * // 'foo=bar'\n * ```\n *\n * @group Query_utils\n */\nexport function stringifyQuery(query: QueryObject): string {\n  return Object.keys(query)\n    .filter((k) => query[k] !== undefined)\n    .map((k) => encodeQueryItem(k, query[k]))\n    .filter(Boolean)\n    .join(\"&\");\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/query.gen.test.ts":{"tests":[{"id":"0","name":"parseQuery should parse \"\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"1","name":"parseQuery should parse \"?foo=bar&baz=qux\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"2","name":"parseQuery should parse \"foo=bar&baz=qux\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"3","name":"parseQuery should parse \"tags=javascript&tags=web&tags=dev\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"4","name":"parseQuery should parse \"foo=bar&foo=baz\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"5","name":"parseQuery should parse \"foo=&bar=baz\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"6","name":"parseQuery should parse \"foo\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"7","name":"parseQuery should parse \"__proto__=polluted&constructor=polluted&safe=val\" correctly","location":{"start":{"column":5,"line":17}}},{"id":"8","name":"parseQuery should handle omitted argument by returning an empty object","location":{"start":{"column":3,"line":22}}},{"id":"9","name":"encodeQueryItem should encode key \"message\" with value correctly","location":{"start":{"column":5,"line":38}}},{"id":"10","name":"encodeQueryItem should encode key \"tags\" with value correctly","location":{"start":{"column":5,"line":38}}},{"id":"11","name":"encodeQueryItem should encode key \"num\" with value correctly","location":{"start":{"column":5,"line":38}}},{"id":"12","name":"encodeQueryItem should encode key \"active\" with value correctly","location":{"start":{"column":5,"line":38}}},{"id":"13","name":"encodeQueryItem should encode key \"empty\" with value correctly","location":{"start":{"column":5,"line":38}}},{"id":"14","name":"encodeQueryItem should encode key \"nil\" with value correctly","location":{"start":{"column":5,"line":38}}},{"id":"15","name":"stringifyQuery should stringify query object correctly","location":{"start":{"column":5,"line":54}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { parseQuery, encodeQueryItem, stringifyQuery } from \"../../src/query\";\n\ndescribe(\"parseQuery\", () => {\n  const cases = [\n    { input: \"\", expected: {} },\n    { input: \"?foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n    { input: \"foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n    { input: \"tags=javascript&tags=web&tags=dev\", expected: { tags: [\"javascript\", \"web\", \"dev\"] } },\n    { input: \"foo=bar&foo=baz\", expected: { foo: [\"bar\", \"baz\"] } },\n    { input: \"foo=&bar=baz\", expected: { foo: \"\", bar: \"baz\" } },\n    { input: \"foo\", expected: { foo: \"\" } },\n    { input: \"__proto__=polluted&constructor=polluted&safe=val\", expected: { safe: \"val\" } },\n  ];\n\n  for (const { input, expected } of cases) {\n    it(`should parse \"${input}\" correctly`, () => {\n      expect(parseQuery(input)).toEqual(expected);\n    });\n  }\n\n  it(\"should handle omitted argument by returning an empty object\", () => {\n    expect(parseQuery()).toEqual({});\n  });\n});\n\ndescribe(\"encodeQueryItem\", () => {\n  const cases = [\n    { key: \"message\", value: \"Hello World\", expected: \"message=Hello+World\" },\n    { key: \"tags\", value: [\"javascript\", \"web\", \"dev\"], expected: \"tags=javascript&tags=web&tags=dev\" },\n    { key: \"num\", value: 123, expected: \"num=123\" },\n    { key: \"active\", value: true, expected: \"active=true\" },\n    { key: \"empty\", value: \"\", expected: \"empty\" },\n    { key: \"nil\", value: null, expected: \"nil\" },\n  ];\n\n  for (const { key, value, expected } of cases) {\n    it(`should encode key \"${key}\" with value correctly`, () => {\n      expect(encodeQueryItem(key, value as any)).toBe(expected);\n    });\n  }\n});\n\ndescribe(\"stringifyQuery\", () => {\n  const cases = [\n    { input: { foo: \"bar\", baz: \"qux\" }, expected: \"foo=bar&baz=qux\" },\n    { input: { foo: \"bar\", baz: undefined }, expected: \"foo=bar\" },\n    { input: { tags: [\"javascript\", \"web\", \"dev\"] }, expected: \"tags=javascript&tags=web&tags=dev\" },\n    { input: {}, expected: \"\" },\n    { input: { num: 42, flag: false }, expected: \"num=42&flag=false\" },\n  ];\n\n  for (const { input, expected } of cases) {\n    it(`should stringify query object correctly`, () => {\n      expect(stringifyQuery(input)).toBe(expected);\n    });\n  }\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/query.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/ufo__query__C2r__r1/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true,"pool":"threads"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"logLevel":"info","maxConcurrentTestRunners":9007199254740991,"maxTestRunnerReuse":0,"mutator":{"plugins":null,"excludedMutations":[]},"appendPlugins":[],"htmlReporter":{"fileName":"reports/mutation/mutation.html"},"symlinkNodeModules":true,"tempDirName":".stryker-tmp","testRunnerNodeArgs":[],"thresholds":{"high":80,"low":60,"break":null},"dryRunTimeoutMinutes":5,"tsconfigFile":"tsconfig.json","warnings":true,"disableBail":false,"allo