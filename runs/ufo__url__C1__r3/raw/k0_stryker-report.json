olumn":6,"line":131},"start":{"column":19,"line":129}}},{"id":"90","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'https://example.com/?a=1&b=2' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.004758999999467,"killedBy":["4"],"coveredBy":["4"],"location":{"end":{"column":4,"line":136},"start":{"column":20,"line":134}}},{"id":"91","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'https://example.com/?a=1&b=2' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.85721999999987,"killedBy":["4"],"coveredBy":["4"],"location":{"end":{"column":4,"line":140},"start":{"column":22,"line":138}}},{"id":"92","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be an instance of $URL","status":"Killed","static":false,"testsCompleted":1,"duration":3.0514509999993606,"killedBy":["7"],"coveredBy":["7"],"location":{"end":{"column":2,"line":148},"start":{"column":48,"line":146}}}],"source":"import { parseURL, parseAuth, parseHost } from \"./parse\";\nimport { QueryObject, parseQuery, stringifyQuery } from \"./query\";\nimport { withoutLeadingSlash, withTrailingSlash } from \"./utils\";\nimport {\n  encodeHash,\n  encodePath,\n  decodePath,\n  decode,\n  encodeHost,\n} from \"./encoding\";\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport class $URL implements URL {\n  protocol: string;\n  host: string;\n  auth: string;\n  pathname: string;\n  query: QueryObject = {};\n  hash: string;\n\n  constructor(input = \"\") {\n    if (typeof input !== \"string\") {\n      throw new TypeError(\n        `URL input should be string received ${typeof input} (${input})`,\n      );\n    }\n\n    const parsed = parseURL(input);\n\n    this.protocol = decode(parsed.protocol);\n    this.host = decode(parsed.host);\n    this.auth = decode(parsed.auth);\n    this.pathname = decodePath(parsed.pathname);\n    this.query = parseQuery(parsed.search);\n    this.hash = decode(parsed.hash);\n  }\n\n  get hostname(): string {\n    return parseHost(this.host).hostname;\n  }\n\n  get port(): string {\n    return parseHost(this.host).port || \"\";\n  }\n\n  get username(): string {\n    return parseAuth(this.auth).username;\n  }\n\n  get password(): string {\n    return parseAuth(this.auth).password || \"\";\n  }\n\n  get hasProtocol() {\n    return this.protocol.length;\n  }\n\n  get isAbsolute() {\n    return this.hasProtocol || this.pathname[0] === \"/\";\n  }\n\n  get search(): string {\n    const q = stringifyQuery(this.query);\n    return q.length > 0 ? \"?\" + q : \"\";\n  }\n\n  get searchParams(): URLSearchParams {\n    const p = new URLSearchParams();\n    for (const name in this.query) {\n      const value = this.query[name];\n      if (Array.isArray(value)) {\n        for (const v of value) {\n          p.append(name, v);\n        }\n      } else {\n        p.append(\n          name,\n          typeof value === \"string\" ? value : JSON.stringify(value),\n        );\n      }\n    }\n    return p;\n  }\n\n  get origin(): string {\n    return (this.protocol ? this.protocol + \"//\" : \"\") + encodeHost(this.host);\n  }\n\n  get fullpath(): string {\n    return encodePath(this.pathname) + this.search + encodeHash(this.hash);\n  }\n\n  get encodedAuth(): string {\n    if (!this.auth) {\n      return \"\";\n    }\n    const { username, password } = parseAuth(this.auth);\n    return (\n      encodeURIComponent(username) +\n      (password ? \":\" + encodeURIComponent(password) : \"\")\n    );\n  }\n\n  get href(): string {\n    const auth = this.encodedAuth;\n    const originWithAuth =\n      (this.protocol ? this.protocol + \"//\" : \"\") +\n      (auth ? auth + \"@\" : \"\") +\n      encodeHost(this.host);\n    return this.hasProtocol && this.isAbsolute\n      ? originWithAuth + this.fullpath\n      : this.fullpath;\n  }\n\n  append(url: $URL) {\n    if (url.hasProtocol) {\n      throw new Error(\"Cannot append a URL with protocol\");\n    }\n\n    Object.assign(this.query, url.query);\n\n    if (url.pathname) {\n      this.pathname =\n        withTrailingSlash(this.pathname) + withoutLeadingSlash(url.pathname);\n    }\n\n    if (url.hash) {\n      this.hash = url.hash;\n    }\n  }\n\n  toJSON(): string {\n    return this.href;\n  }\n\n  toString(): string {\n    return this.href;\n  }\n}\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport function createURL(input: string): $URL {\n  return new $URL(input);\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/url.gen.test.ts":{"tests":[{"id":"0","name":"url $URL should parse a basic absolute URL correctly","location":{"start":{"column":5,"line":6}}},{"id":"1","name":"url $URL should handle invalid input types with TypeError","location":{"start":{"column":5,"line":21}}},{"id":"2","name":"url $URL should parse URL with auth, port, username, password","location":{"start":{"column":5,"line":26}}},{"id":"3","name":"url $URL should parse relative URLs and compute isAbsolute","location":{"start":{"column":5,"line":35}}},{"id":"4","name":"url $URL should support searchParams and methods like toJSON / toString","location":{"start":{"column":5,"line":46}}},{"id":"5","name":"url $URL should append another $URL correctly","location":{"start":{"column":5,"line":54}}},{"id":"6","name":"url $URL should throw when appending a URL with a protocol","location":{"start":{"column":5,"line":65}}},{"id":"7","name":"url createURL should return an instance of $URL","location":{"start":{"column":5,"line":76}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { $URL, createURL } from \"../../src/url\";\n\ndescribe(\"url\", () => {\n  describe(\"$URL\", () => {\n    it(\"should parse a basic absolute URL correctly\", () => {\n      const url = new $URL(\"https://example.com/path?foo=bar#hash\");\n      expect(url.protocol).toBe(\"https:\");\n      expect(url.host).toBe(\"example.com\");\n      expect(url.hostname).toBe(\"example.com\");\n      expect(url.pathname).toBe(\"/path\");\n      expect(url.query).toEqual({ foo: \"bar\" });\n      expect(url.hash).toBe(\"#hash\");\n      expect(url.hasProtocol).toBeTruthy();\n      expect(url.isAbsolute).toBeTruthy();\n      expect(url.search).toBe(\"?foo=bar\");\n      expect(url.origin).toBe(\"https://example.com\");\n      expect(url.href).toBe(\"https://example.com/path?foo=bar#hash\");\n    });\n\n    it(\"should handle invalid input types with TypeError\", () => {\n      // @ts-expect-error testing invalid type\n      expect(() => new $URL(123)).toThrowError(TypeError);\n    });\n\n    it(\"should parse URL with auth, port, username, password\", () => {\n      const url = new $URL(\"http://user:pass@example.com:8080/path\");\n      expect(url.username).toBe(\"user\");\n      expect(url.password).toBe(\"pass\");\n      expect(url.port).toBe(\"8080\");\n      expect(url.encodedAuth).toBe(\"user:pass\");\n      expect(url.origin).toBe(\"http://example.com:8080\");\n    });\n\n    it(\"should parse relative URLs and compute isAbsolute\", () => {\n      const urlWithSlash = new $URL(\"/relative/path\");\n      expect(urlWithSlash.isAbsolute).toBeTruthy();\n      expect(urlWithSlash.hasProtocol).toBeFalsy();\n      expect(urlWithSlash.href).toBe(\"/relative/path\");\n\n      const urlWithoutSlash = new $URL(\"relative/path\");\n      expect(urlWithoutSlash.isAbsolute).toBeFalsy();\n      expect(urlWithoutSlash.href).toBe(\"relative/path\");\n    });\n\n    it(\"should support searchParams and methods like toJSON / toString\", () => {\n      const url = new $URL(\"https://example.com/?a=1&b=2\");\n      expect(url.searchParams.get(\"a\")).toBe(\"1\");\n      expect(url.searchParams.get(\"b\")).toBe(\"2\");\n      expect(url.toJSON()).toBe(\"https://example.com/?a=1&b=2\");\n      expect(url.toString()).toBe(\"https://example.com/?a=1&b=2\");\n    });\n\n    it(\"should append another $URL correctly\", () => {\n      const base = new $URL(\"https://example.com/base?a=1\");\n      const sub = new $URL(\"/sub?b=2#newhash\");\n\n      base.append(sub);\n\n      expect(base.pathname).toBe(\"/base/sub\");\n      expect(base.query).toEqual({ a: \"1\", b: \"2\" });\n      expect(base.hash).toBe(\"#newhash\");\n    });\n\n    it(\"should throw when appending a URL with a protocol\", () => {\n      const base = new $URL(\"https://example.com/base\");\n      const other = new $URL(\"https://other.com/sub\");\n\n      expect(() => base.append(other)).toThrowError(\n        \"Cannot append a URL with protocol\",\n      );\n    });\n  });\n\n  describe(\"createURL\", () => {\n    it(\"should return an instance of $URL\", () => {\n      const url = createURL(\"https://example.com\");\n      expect(url).toBeInstanceOf($URL);\n      expect(url.host).toBe(\"example.com\");\n    });\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/url.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/ufo__url__C1__r3/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true,"pool":"threads"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eve