// { tags: [\"javascript\", \"web\", \"dev\"] }\n * ```\n *\n * @note\n * The `__proto__` and `constructor` keys are ignored to prevent prototype pollution.\n *\n * @group Query_utils\n */\nexport function parseQuery<T extends ParsedQuery = ParsedQuery>(\n  parametersString = \"\",\n): T {\n  // TODO: Use new EmptyObject() instead of Object.create(null) for better performance in next major version\n  // https://github.com/unjs/ufo/pull/290\n  const object: ParsedQuery = Object.create(null);\n  if (parametersString[0] === \"?\") {\n    parametersString = parametersString.slice(1);\n  }\n  for (const parameter of parametersString.split(\"&\")) {\n    const s = parameter.match(/([^=]+)=?(.*)/) || [];\n    if (s.length < 2) {\n      continue;\n    }\n    const key = decodeQueryKey(s[1]);\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n    const value = decodeQueryValue(s[2] || \"\");\n    if (object[key] === undefined) {\n      object[key] = value;\n    } else if (Array.isArray(object[key])) {\n      (object[key] as string[]).push(value);\n    } else {\n      object[key] = [object[key] as string, value];\n    }\n  }\n  return object as T;\n}\n\n/**\n * Encodes a pair of key and value into a url query string value.\n *\n * If the value is an array, it will be encoded as multiple key-value pairs with the same key.\n *\n * @example\n *\n * ```js\n * encodeQueryItem('message', 'Hello World')\n * // 'message=Hello+World'\n *\n * encodeQueryItem('tags', ['javascript', 'web', 'dev'])\n * // 'tags=javascript&tags=web&tags=dev'\n * ```\n *\n * @group Query_utils\n */\nexport function encodeQueryItem(\n  key: string,\n  value: QueryValue | QueryValue[],\n): string {\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    value = String(value);\n  }\n  if (!value) {\n    return encodeQueryKey(key);\n  }\n\n  if (Array.isArray(value)) {\n    return value\n      .map(\n        (_value: QueryValue) =>\n          `${encodeQueryKey(key)}=${encodeQueryValue(_value)}`,\n      )\n      .join(\"&\");\n  }\n\n  return `${encodeQueryKey(key)}=${encodeQueryValue(value)}`;\n}\n\n/**\n * Stringfies and encodes a query object into a query string.\n *\n * @example\n *\n * ```js\n * stringifyQuery({ foo: 'bar', baz: 'qux' })\n * // 'foo=bar&baz=qux'\n *\n * stringifyQuery({ foo: 'bar', baz: undefined })\n * // 'foo=bar'\n * ```\n *\n * @group Query_utils\n */\nexport function stringifyQuery(query: QueryObject): string {\n  return Object.keys(query)\n    .filter((k) => query[k] !== undefined)\n    .map((k) => encodeQueryItem(k, query[k]))\n    .filter(Boolean)\n    .join(\"&\");\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/query.gen.test.ts":{"tests":[{"id":"0","name":"parseQuery should parse \"\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"1","name":"parseQuery should parse \"?foo=bar\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"2","name":"parseQuery should parse \"foo=bar&baz=qux\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"3","name":"parseQuery should parse \"?foo=bar&baz=qux\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"4","name":"parseQuery should parse \"tags=javascript&tags=web&tags=dev\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"5","name":"parseQuery should parse \"foo=bar&foo=baz\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"6","name":"parseQuery should parse \"foo&bar=baz\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"7","name":"parseQuery should parse \"__proto__=polluted&constructor=polluted&safe=val\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"8","name":"parseQuery should parse \"a=1&b=true&c=false\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"9","name":"parseQuery should parse \"message=Hello+World\" correctly","location":{"start":{"column":5,"line":19}}},{"id":"10","name":"parseQuery should use default empty string when parametersString is omitted","location":{"start":{"column":3,"line":24}}},{"id":"11","name":"parseQuery should handle segments without equals sign or empty value correctly","location":{"start":{"column":3,"line":28}}},{"id":"12","name":"parseQuery should ignore prototype pollution keys","location":{"start":{"column":3,"line":33}}},{"id":"13","name":"encodeQueryItem should encode item message=\"Hello World\" correctly","location":{"start":{"column":5,"line":53}}},{"id":"14","name":"encodeQueryItem should encode item tags=[\"javascript\",\"web\",\"dev\"] correctly","location":{"start":{"column":5,"line":53}}},{"id":"15","name":"encodeQueryItem should encode item count=42 correctly","location":{"start":{"column":5,"line":53}}},{"id":"16","name":"encodeQueryItem should encode item active=true correctly","location":{"start":{"column":5,"line":53}}},{"id":"17","name":"encodeQueryItem should encode item active=false correctly","location":{"start":{"column":5,"line":53}}},{"id":"18","name":"encodeQueryItem should encode item empty=\"\" correctly","location":{"start":{"column":5,"line":53}}},{"id":"19","name":"encodeQueryItem should encode item nullVal=null correctly","location":{"start":{"column":5,"line":53}}},{"id":"20","name":"encodeQueryItem should encode item undefVal=undefined correctly","location":{"start":{"column":5,"line":53}}},{"id":"21","name":"encodeQueryItem should handle number zero and boolean false correctly without treating them as falsy","location":{"start":{"column":3,"line":58}}},{"id":"22","name":"stringifyQuery should stringify query object correctly","location":{"start":{"column":5,"line":75}}},{"id":"23","name":"stringifyQuery should filter out falsy encoded items produced by empty keys or values","location":{"start":{"column":3,"line":80}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { parseQuery, encodeQueryItem, stringifyQuery } from \"../../src/query\";\n\ndescribe(\"parseQuery\", () => {\n  const cases = [\n    { input: \"\", expected: {} },\n    { input: \"?foo=bar\", expected: { foo: \"bar\" } },\n    { input: \"foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n    { input: \"?foo=bar&baz=qux\", expected: { foo: \"bar\", baz: \"qux\" } },\n    { input: \"tags=javascript&tags=web&tags=dev\", expected: { tags: [\"javascript\", \"web\", \"dev\"] } },\n    { input: \"foo=bar&foo=baz\", expected: { foo: [\"bar\", \"baz\"] } },\n    { input: \"foo&bar=baz\", expected: { foo: \"\", bar: \"baz\" } },\n    { input: \"__proto__=polluted&constructor=polluted&safe=val\", expected: { safe: \"val\" } },\n    { input: \"a=1&b=true&c=false\", expected: { a: \"1\", b: \"true\", c: \"false\" } },\n    { input: \"message=Hello+World\", expected: { message: \"Hello World\" } },\n  ];\n\n  for (const { input, expected } of cases) {\n    it(`should parse \"${input}\" correctly`, () => {\n      expect(parseQuery(input)).toEqual(expected);\n    });\n  }\n\n  it(\"should use default empty string when parametersString is omitted\", () => {\n    expect(parseQuery()).toEqual({});\n  });\n\n  it(\"should handle segments without equals sign or empty value correctly\", () => {\n    expect(parseQuery(\"invalidsegment\")).toEqual({ invalidsegment: \"\" });\n    expect(parseQuery(\"key=\")).toEqual({ key: \"\" });\n  });\n\n  it(\"should ignore prototype pollution keys\", () => {\n    const result = parseQuery(\"__proto__[foo]=bar&constructor[prototype]=bad\");\n    expect(result.__proto__).toBeUndefined();\n    expect(result.constructor).toBeUndefined();\n  });\n});\n\ndescribe(\"encodeQueryItem\", () => {\n  const cases = [\n    { key: \"message\", value: \"Hello World\", expected: \"message=Hello+World\" },\n    { key: \"tags\", value: [\"javascript\", \"web\", \"dev\"], expected: \"tags=javascript&tags=web&tags=dev\" },\n    { key: \"count\", value: 42, expected: \"count=42\" },\n    { key: \"active\", value: true, expected: \"active=true\" },\n    { key: \"active\", value: false, expected: \"active=false\" },\n    { key: \"empty\", value: \"\", expected: \"empty\" },\n    { key: \"nullVal\", value: null, expected: \"nullVal\" },\n    { key: \"undefVal\", value: undefined, expected: \"undefVal\" },\n  ];\n\n  for (const { key, value, expected } of cases) {\n    it(`should encode item ${key}=${JSON.stringify(value)} correctly`, () => {\n      expect(encodeQueryItem(key, value as any)).toBe(expected);\n    });\n  }\n\n  it(\"should handle number zero and boolean false correctly without treating them as falsy\", () => {\n    expect(encodeQueryItem(\"num\", 0)).toBe(\"num=0\");\n    expect(encodeQueryItem(\"bool\", false)).toBe(\"bool=false\");\n  });\n});\n\ndescribe(\"stringifyQuery\", () => {\n  const cases = [\n    { input: { foo: \"bar\", baz: \"qux\" }, expected: \"foo=bar&baz=qux\" },\n    { input: { foo: \"bar\", baz: undefined }, expected: \"foo=bar\" },\n    { input: { tags: [\"javascript\", \"web\", \"dev\"] }, expected: \"tags=javascript&tags=web&tags=dev\" },\n    { input: {}, expected: \"\" },\n    { input: { a: 1, b: true, c: false }, expected: \"a=1&b=true&c=false\" },\n    { input: { message: \"Hello World\" }, expected: \"message=Hello+World\" },\n  ];\n\n  for (const { input, expected } of cases) {\n    it(`should stringify query object correctly`, () => {\n      expect(stringifyQuery(input)).toBe(expected);\n    });\n  }\n\n  it(\"should filter out falsy encoded items produced by empty keys or values\", () => {\n    expect(stringifyQuery({ foo: \"bar\" })).toBe(\"foo=bar\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/query.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/ufo__query__C3__r3/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","r