e '#new' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.834729000000152,"killedBy":["9"],"coveredBy":["9","11"],"location":{"end":{"column":17,"line":129},"start":{"column":9,"line":129}}},{"id":"89","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected '#old' to be '#new' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.94511600000078,"killedBy":["9"],"coveredBy":["9"],"location":{"end":{"column":6,"line":131},"start":{"column":19,"line":129}}},{"id":"90","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be '' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.631085999999414,"killedBy":["1"],"coveredBy":["1"],"location":{"end":{"column":4,"line":136},"start":{"column":20,"line":134}}},{"id":"91","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be '' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.761050999999497,"killedBy":["1"],"coveredBy":["1"],"location":{"end":{"column":4,"line":140},"start":{"column":22,"line":138}}},{"id":"92","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be an instance of $URL","status":"Killed","static":false,"testsCompleted":1,"duration":2.987797000001592,"killedBy":["12"],"coveredBy":["12"],"location":{"end":{"column":2,"line":148},"start":{"column":48,"line":146}}}],"source":"import { parseURL, parseAuth, parseHost } from \"./parse\";\nimport { QueryObject, parseQuery, stringifyQuery } from \"./query\";\nimport { withoutLeadingSlash, withTrailingSlash } from \"./utils\";\nimport {\n  encodeHash,\n  encodePath,\n  decodePath,\n  decode,\n  encodeHost,\n} from \"./encoding\";\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport class $URL implements URL {\n  protocol: string;\n  host: string;\n  auth: string;\n  pathname: string;\n  query: QueryObject = {};\n  hash: string;\n\n  constructor(input = \"\") {\n    if (typeof input !== \"string\") {\n      throw new TypeError(\n        `URL input should be string received ${typeof input} (${input})`,\n      );\n    }\n\n    const parsed = parseURL(input);\n\n    this.protocol = decode(parsed.protocol);\n    this.host = decode(parsed.host);\n    this.auth = decode(parsed.auth);\n    this.pathname = decodePath(parsed.pathname);\n    this.query = parseQuery(parsed.search);\n    this.hash = decode(parsed.hash);\n  }\n\n  get hostname(): string {\n    return parseHost(this.host).hostname;\n  }\n\n  get port(): string {\n    return parseHost(this.host).port || \"\";\n  }\n\n  get username(): string {\n    return parseAuth(this.auth).username;\n  }\n\n  get password(): string {\n    return parseAuth(this.auth).password || \"\";\n  }\n\n  get hasProtocol() {\n    return this.protocol.length;\n  }\n\n  get isAbsolute() {\n    return this.hasProtocol || this.pathname[0] === \"/\";\n  }\n\n  get search(): string {\n    const q = stringifyQuery(this.query);\n    return q.length > 0 ? \"?\" + q : \"\";\n  }\n\n  get searchParams(): URLSearchParams {\n    const p = new URLSearchParams();\n    for (const name in this.query) {\n      const value = this.query[name];\n      if (Array.isArray(value)) {\n        for (const v of value) {\n          p.append(name, v);\n        }\n      } else {\n        p.append(\n          name,\n          typeof value === \"string\" ? value : JSON.stringify(value),\n        );\n      }\n    }\n    return p;\n  }\n\n  get origin(): string {\n    return (this.protocol ? this.protocol + \"//\" : \"\") + encodeHost(this.host);\n  }\n\n  get fullpath(): string {\n    return encodePath(this.pathname) + this.search + encodeHash(this.hash);\n  }\n\n  get encodedAuth(): string {\n    if (!this.auth) {\n      return \"\";\n    }\n    const { username, password } = parseAuth(this.auth);\n    return (\n      encodeURIComponent(username) +\n      (password ? \":\" + encodeURIComponent(password) : \"\")\n    );\n  }\n\n  get href(): string {\n    const auth = this.encodedAuth;\n    const originWithAuth =\n      (this.protocol ? this.protocol + \"//\" : \"\") +\n      (auth ? auth + \"@\" : \"\") +\n      encodeHost(this.host);\n    return this.hasProtocol && this.isAbsolute\n      ? originWithAuth + this.fullpath\n      : this.fullpath;\n  }\n\n  append(url: $URL) {\n    if (url.hasProtocol) {\n      throw new Error(\"Cannot append a URL with protocol\");\n    }\n\n    Object.assign(this.query, url.query);\n\n    if (url.pathname) {\n      this.pathname =\n        withTrailingSlash(this.pathname) + withoutLeadingSlash(url.pathname);\n    }\n\n    if (url.hash) {\n      this.hash = url.hash;\n    }\n  }\n\n  toJSON(): string {\n    return this.href;\n  }\n\n  toString(): string {\n    return this.href;\n  }\n}\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport function createURL(input: string): $URL {\n  return new $URL(input);\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/url.gen.test.ts":{"tests":[{"id":"0","name":"$URL should parse absolute URL with protocol, host, pathname, query and hash","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"$URL should handle default empty input","location":{"start":{"column":3,"line":19}}},{"id":"2","name":"$URL should handle authentication details","location":{"start":{"column":3,"line":31}}},{"id":"3","name":"$URL should handle username without password","location":{"start":{"column":3,"line":40}}},{"id":"4","name":"$URL should return empty encodedAuth when auth is missing","location":{"start":{"column":3,"line":48}}},{"id":"5","name":"$URL should calculate hasProtocol and isAbsolute correctly","location":{"start":{"column":3,"line":53}}},{"id":"6","name":"$URL should generate searchParams correctly","location":{"start":{"column":3,"line":67}}},{"id":"7","name":"$URL should handle array and non-string values in searchParams","location":{"start":{"column":3,"line":75}}},{"id":"8","name":"$URL should throw TypeError on non-string input","location":{"start":{"column":3,"line":83}}},{"id":"9","name":"$URL append should append pathname, query and hash","location":{"start":{"column":5,"line":91}}},{"id":"10","name":"$URL append should throw error when appending a URL with protocol","location":{"start":{"column":5,"line":101}}},{"id":"11","name":"$URL append should not modify pathname or hash if they are empty on appended url","location":{"start":{"column":5,"line":109}}},{"id":"12","name":"createURL should create an instance of $URL","location":{"start":{"column":3,"line":121}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { $URL, createURL } from \"../../src/url\";\n\ndescribe(\"$URL\", () => {\n  it(\"should parse absolute URL with protocol, host, pathname, query and hash\", () => {\n    const url = new $URL(\"https://example.com:8080/path/to/page?foo=bar#hash\");\n    expect(url.protocol).toBe(\"https:\");\n    expect(url.host).toBe(\"example.com:8080\");\n    expect(url.hostname).toBe(\"example.com\");\n    expect(url.port).toBe(\"8080\");\n    expect(url.pathname).toBe(\"/path/to/page\");\n    expect(url.query).toEqual({ foo: \"bar\" });\n    expect(url.hash).toBe(\"#hash\");\n    expect(url.search).toBe(\"?foo=bar\");\n    expect(url.origin).toBe(\"https://example.com:8080\");\n    expect(url.href).toBe(\"https://example.com:8080/path/to/page?foo=bar#hash\");\n  });\n\n  it(\"should handle default empty input\", () => {\n    const url = new $URL();\n    expect(url.protocol).toBe(\"\");\n    expect(url.host).toBe(\"\");\n    expect(url.pathname).toBe(\"\");\n    expect(url.query).toEqual({});\n    expect(url.hash).toBe(\"\");\n    expect(url.href).toBe(\"\");\n    expect(url.toString()).toBe(\"\");\n    expect(url.toJSON()).toBe(\"\");\n  });\n\n  it(\"should handle authentication details\", () => {\n    const url = new $URL(\"https://user:pass@example.com/\");\n    expect(url.username).toBe(\"user\");\n    expect(url.password).toBe(\"pass\");\n    expect(url.auth).toBe(\"user:pass\");\n    expect(url.encodedAuth).toBe(\"user:pass\");\n    expect(url.href).toBe(\"https://user:pass@example.com/\");\n  });\n\n  it(\"should handle username without password\", () => {\n    const url = new $URL(\"https://user@example.com/\");\n    expect(url.username).toBe(\"user\");\n    expect(url.password).toBe(\"\");\n    expect(url.auth).toBe(\"user\");\n    expect(url.encodedAuth).toBe(\"user\");\n  });\n\n  it(\"should return empty encodedAuth when auth is missing\", () => {\n    const url = new $URL(\"https://example.com/\");\n    expect(url.encodedAuth).toBe(\"\");\n  });\n\n  it(\"should calculate hasProtocol and isAbsolute correctly\", () => {\n    const absUrl = new $URL(\"https://example.com\");\n    expect(absUrl.hasProtocol).toBeTruthy();\n    expect(absUrl.isAbsolute).toBeTruthy();\n\n    const relUrl = new $URL(\"/foo/bar\");\n    expect(relUrl.hasProtocol).toBeFalsy();\n    expect(relUrl.isAbsolute).toBeTruthy();\n\n    const relativePath = new $URL(\"foo/bar\");\n    expect(relativePath.hasProtocol).toBeFalsy();\n    expect(relativePath.isAbsolute).toBeFalsy();\n  });\n\n  it(\"should generate searchParams correctly\", () => {\n    const url = new $URL(\"https://example.com/?a=1&b=2&a=3\");\n    const params = url.searchParams;\n    expect(params.get(\"a\")).toBe(\"1\");\n    expect(params.getAll(\"a\")).toEqual([\"1\", \"3\"]);\n    expect(params.get(\"b\")).toBe(\"2\");\n  });\n\n  it(\"should handle array and non-string values in searchParams\", () => {\n    const url = new $URL(\"https://example.com\");\n    url.query = { tags: [\"vue\", \"react\"], count: 10 as unknown as string };\n    const params = url.searchParams;\n    expect(params.getAll(\"tags\")).toEqual([\"vue\", \"react\"]);\n    expect(params.get(\"count\")).toBe(\"10\");\n  });\n\n  it(\"should throw TypeError on non-string input\", () => {\n    expect(() => new $URL(123 as unknown as string)).toThrow(TypeError);\n    expect(() => new $URL(123 as unknown as string)).toThrow(\n      \"URL input should be string received number (123)\"\n    );\n  });\n\n  describe(\"append\", () => {\n    it(\"should append pathname, query and hash\", () => {\n      const base = new $URL(\"https://example.com/base?a=1#old\");\n      const other = new $URL(\"/sub?b=2#new\");\n      base.append(other);\n      expect(base.pathname).toBe(\"/base/sub\");\n      expect(base.query).toEqual({ a: \"1\", b: \"2\" });\n      expect(base.hash).toBe(\"#new\");\n      expect(base.href).toBe(\"https://example.com/base/sub?a=1&b=2#new\");\n    });\n\n    it(\"should throw error when appending a URL with protocol\", () => {\n      const base = new $URL(\"https://example.com/base\");\n      const other = new $URL(\"https://other.com/sub\");\n      expect(() => base.append(other)).toThrow(\n        \"Cannot append a URL with protocol\"\n      );\n    });\n\n    it(\"should not modify pathname or hash if they are empty on appended url\", () => {\n      const base = new $URL(\"https://example.com/base?a=1#hash\");\n      const other = new $URL(\"?b=2\");\n      base.append(other);\n      expect(base.pathname).toBe(\"/base\");\n      expect(base.hash).toBe(\"#hash\");\n      expect(base.query).toEqual({ a: \"1\", b: \"2\" });\n    });\n  });\n});\n\ndescribe(\"createURL\", () => {\n  it(\"should create an instance of $URL\", () => {\n    const url = createURL(\"https://example.com/test\");\n    expect(url).toBeInstanceOf($URL);\n    expect(url.href).toBe(\"https://example.com/test\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/url.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-eva