erger?: Merger): T {\n  if (!isPlainObject(defaults)) {\n    return _defu(baseObject, {}, namespace, merger);\n  }\n\n  const object = { ...defaults };\n\n  for (const key of Object.keys(baseObject as Record<string, any>)) {\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n\n    const value = (baseObject as Record<string, any>)[key];\n\n    if (value === null || value === undefined) {\n      continue;\n    }\n\n    if (merger && merger(object, key, value, namespace)) {\n      continue;\n    }\n\n    if (Array.isArray(value) && Array.isArray(object[key])) {\n      object[key] = [...value, ...object[key]];\n    } else if (isPlainObject(value) && isPlainObject(object[key])) {\n      object[key] = _defu(\n        value,\n        object[key],\n        (namespace ? `${namespace}.` : \"\") + key.toString(),\n        merger,\n      );\n    } else {\n      object[key] = value;\n    }\n  }\n\n  return object;\n}\n\n// Create defu wrapper with optional merger and multi arg support\nexport function createDefu(merger?: Merger): DefuFunction {\n  return (...arguments_) =>\n    // eslint-disable-next-line unicorn/no-array-reduce\n    arguments_.reduce((p, c) => _defu(p, c, \"\", merger), {} as any);\n}\n\n// Standard version\nexport const defu = createDefu() as DefuInstance;\nexport default defu;\n\n// Custom version with function merge support\nexport const defuFn = createDefu((object, key, currentValue) => {\n  if (object[key] !== undefined && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\n// Custom version with function merge support only for defined arrays\nexport const defuArrayFn = createDefu((object, key, currentValue) => {\n  if (Array.isArray(object[key]) && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\nexport type { Defu, DefuFn, DefuInstance } from \"./types\";\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/defu.gen.test.ts":{"tests":[{"id":"0","name":"defu should merge basic objects with defaults","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"defu should handle multiple arguments in correct priority order","location":{"start":{"column":3,"line":13}}},{"id":"2","name":"defu should ignore null and undefined values in base object","location":{"start":{"column":3,"line":19}}},{"id":"3","name":"defu should recursively merge plain objects","location":{"start":{"column":3,"line":27}}},{"id":"4","name":"defu should concatenate arrays","location":{"start":{"column":3,"line":41}}},{"id":"5","name":"defu should protect against prototype pollution","location":{"start":{"column":3,"line":49}}},{"id":"6","name":"defu should fallback to empty object if defaults is not a plain object","location":{"start":{"column":3,"line":58}}},{"id":"7","name":"defu should pass the correct namespace path to custom merger during nested merges","location":{"start":{"column":3,"line":65}}},{"id":"8","name":"createDefu should allow custom mergers","location":{"start":{"column":3,"line":93}}},{"id":"9","name":"defuFn should call functions when merging existing keys","location":{"start":{"column":3,"line":108}}},{"id":"10","name":"defuFn should not call functions if key does not exist in object","location":{"start":{"column":3,"line":122}}},{"id":"11","name":"defuFn should not execute function if object has undefined for that key","location":{"start":{"column":3,"line":132}}},{"id":"12","name":"defuArrayFn should call functions only when merging defined arrays","location":{"start":{"column":3,"line":146}}},{"id":"13","name":"defuArrayFn should not call functions if target is not an array","location":{"start":{"column":3,"line":160}}},{"id":"14","name":"defuArrayFn should not call function if target array is undefined","location":{"start":{"column":3,"line":172}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { defu, createDefu, defuFn, defuArrayFn } from \"../../src/defu\";\n\ndescribe(\"defu\", () => {\n  it(\"should merge basic objects with defaults\", () => {\n    const base = { a: 1, c: 3 };\n    const defaults = { a: 2, b: 2 };\n    const result = defu(base, defaults);\n\n    expect(result).toEqual({ a: 1, b: 2, c: 3 });\n  });\n\n  it(\"should handle multiple arguments in correct priority order\", () => {\n    const result = defu({ a: 1 }, { a: 2, b: 2 }, { b: 3, c: 3 });\n\n    expect(result).toEqual({ a: 1, b: 2, c: 3 });\n  });\n\n  it(\"should ignore null and undefined values in base object\", () => {\n    const base = { a: null, b: undefined, c: 1 };\n    const defaults = { a: 10, b: 20, c: 30 };\n    const result = defu(base, defaults);\n\n    expect(result).toEqual({ a: 10, b: 20, c: 1 });\n  });\n\n  it(\"should recursively merge plain objects\", () => {\n    const base = {\n      nested: { a: 1, c: 3 }\n    };\n    const defaults = {\n      nested: { a: 2, b: 2 }\n    };\n    const result = defu(base, defaults);\n\n    expect(result).toEqual({\n      nested: { a: 1, b: 2, c: 3 }\n    });\n  });\n\n  it(\"should concatenate arrays\", () => {\n    const base = { arr: [3, 4] };\n    const defaults = { arr: [1, 2] };\n    const result = defu(base, defaults);\n\n    expect(result).toEqual({ arr: [3, 4, 1, 2] });\n  });\n\n  it(\"should protect against prototype pollution\", () => {\n    const base = JSON.parse('{\"__proto__\": {\"polluted\": true}, \"constructor\": {\"prototype\": {\"polluted\": true}}, \"a\": 1}');\n    const defaults = { a: 2 };\n    const result = defu(base, defaults);\n\n    expect(result).toEqual({ a: 1 });\n    expect(({} as any).polluted).toBeUndefined();\n  });\n\n  it(\"should fallback to empty object if defaults is not a plain object\", () => {\n    const base = { a: 1 };\n    const result = defu(base, null as any);\n\n    expect(result).toEqual({ a: 1 });\n  });\n\n  it(\"should pass the correct namespace path to custom merger during nested merges\", () => {\n    const paths: string[] = [];\n    const custom = createDefu((_object, _key, _value, namespace) => {\n      paths.push(namespace);\n    });\n\n    const base = {\n      level1: {\n        level2: {\n          a: 1\n        }\n      }\n    };\n    const defaults = {\n      level1: {\n        level2: {\n          a: 2\n        }\n      }\n    };\n\n    custom(base, defaults);\n\n    expect(paths).toContain(\"level1.level2\");\n  });\n});\n\ndescribe(\"createDefu\", () => {\n  it(\"should allow custom mergers\", () => {\n    const custom = createDefu((object, key, value) => {\n      if (key === \"special\") {\n        object[key] = `custom_${value}`;\n        return true;\n      }\n    });\n\n    const result = custom({ special: \"value\" }, { special: \"default\" });\n\n    expect(result).toEqual({ special: \"custom_value\" });\n  });\n});\n\ndescribe(\"defuFn\", () => {\n  it(\"should call functions when merging existing keys\", () => {\n    const base = {\n      callback: (val: number) => val + 1\n    };\n    const defaults = {\n      callback: 10\n    };\n    const result = defuFn(base, defaults);\n\n    expect(result).toEqual({\n      callback: 11\n    });\n  });\n\n  it(\"should not call functions if key does not exist in object\", () => {\n    const base = {};\n    const defaults = {\n      callback: (val: number) => val + 1\n    };\n    const result = defuFn(base, defaults);\n\n    expect(typeof result.callback).toBe(\"function\");\n  });\n\n  it(\"should not execute function if object has undefined for that key\", () => {\n    const base = {\n      callback: undefined\n    };\n    const defaults = {\n      callback: (val: number) => val + 1\n    };\n    const result = defuFn(base, defaults);\n\n    expect(typeof result.callback).toBe(\"function\");\n  });\n});\n\ndescribe(\"defuArrayFn\", () => {\n  it(\"should call functions only when merging defined arrays\", () => {\n    const base = {\n      arr: (val: number[]) => [...val, 3]\n    };\n    const defaults = {\n      arr: [1, 2]\n    };\n    const result = defuArrayFn(base, defaults);\n\n    expect(result).toEqual({\n      arr: [1, 2, 3]\n    });\n  });\n\n  it(\"should not call functions if target is not an array\", () => {\n    const base = {\n      arr: (val: string) => `${val}_modified`\n    };\n    const defaults = {\n      arr: \"not_an_array\"\n    };\n    const result = defuArrayFn(base, defaults);\n\n    expect(typeof result.arr).toBe(\"function\");\n  });\n\n  it(\"should not call function if target array is undefined\", () => {\n    const base = {\n      arr: undefined\n    };\n    const defaults = {\n      arr: (val: number[]) => [...val, 3]\n    };\n    const result = defuArrayFn(base, defaults);\n\n    expect(typeof result.arr).toBe(\"function\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/defu","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/defu.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/defu__defu__C3__r2/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true,"pool":"threads"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"log