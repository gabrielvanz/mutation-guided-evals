);\n\nconst SLASH_RE = /[/\\\\]/;\n\n/**\n * Normalises alias mappings, ensuring that more specific aliases are resolved before less specific ones.\n * This function also ensures that aliases do not resolve to themselves cyclically.\n *\n * @param _aliases - A set of alias mappings where each key is an alias and its value is the actual path it points to.\n * @returns a set of normalised alias mappings.\n */\nexport function normalizeAliases(_aliases: Record<string, string>) {\n  if ((_aliases as any)[normalizedAliasSymbol]) {\n    return _aliases;\n  }\n\n  // Sort aliases from specific to general (ie. fs/promises before fs)\n  const aliases = Object.fromEntries(\n    Object.entries(_aliases).sort(([a], [b]) => _compareAliases(a, b)),\n  );\n\n  // Resolve alias values in relation to each other\n  for (const key in aliases) {\n    for (const alias in aliases) {\n      // don't resolve a more specific alias with regard to a less specific one\n      if (alias === key || key.startsWith(alias)) {\n        continue;\n      }\n\n      if (aliases[key]?.startsWith(alias) && pathSeparators.has(aliases[key][alias.length])) {\n        aliases[key] = aliases[alias] + aliases[key].slice(alias.length);\n      }\n    }\n  }\n\n  Object.defineProperty(aliases, normalizedAliasSymbol, {\n    value: true,\n    enumerable: false,\n  });\n  return aliases;\n}\n\n/**\n * Resolves a path string to its alias if applicable, otherwise returns the original path.\n * This function normalises the path, resolves the alias and then joins it to the alias target if necessary.\n *\n * @param path - The path string to resolve.\n * @param aliases - A set of alias mappings to use for resolution.\n * @returns the resolved path as a string.\n */\nexport function resolveAlias(path: string, aliases: Record<string, string>) {\n  const _path = normalizeWindowsPath(path);\n  aliases = normalizeAliases(aliases);\n  for (const [alias, to] of Object.entries(aliases)) {\n    if (!_path.startsWith(alias)) {\n      continue;\n    }\n\n    // Strip trailing slash from alias for check\n    const _alias = hasTrailingSlash(alias) ? alias.slice(0, -1) : alias;\n\n    if (hasTrailingSlash(_path[_alias.length])) {\n      return join(to, _path.slice(alias.length));\n    }\n  }\n  return _path;\n}\n\n/**\n * Resolves a path string to its possible alias.\n *\n * Returns an array of possible alias resolutions (could be empty), sorted by specificity (longest first).\n */\nexport function reverseResolveAlias(path: string, aliases: Record<string, string>): string[] {\n  const _path = normalizeWindowsPath(path);\n  aliases = normalizeAliases(aliases);\n\n  const matches: string[] = [];\n\n  for (const [to, alias] of Object.entries(aliases)) {\n    if (!_path.startsWith(alias)) {\n      continue;\n    }\n\n    // Strip trailing slash from alias for check\n    const _alias = hasTrailingSlash(alias) ? alias.slice(0, -1) : alias;\n\n    if (hasTrailingSlash(_path[_alias.length])) {\n      matches.push(join(to, _path.slice(alias.length)));\n    }\n  }\n\n  // Sort by length, longest (more specific) first\n  return matches.sort((a, b) => b.length - a.length);\n}\n\n/**\n * Extracts the filename from a given path, excluding any directory paths and the file extension.\n *\n * @param path - The full path of the file from which to extract the filename.\n * @returns the filename without the extension, or `undefined` if the filename cannot be extracted.\n */\nexport function filename(path: string) {\n  const base = path.split(SLASH_RE).pop();\n\n  if (!base) {\n    return undefined;\n  }\n\n  const separatorIndex = base.lastIndexOf(\".\");\n\n  if (separatorIndex <= 0) {\n    return base;\n  }\n\n  return base.slice(0, separatorIndex);\n}\n\n// --- internals ---\n\nfunction _compareAliases(a: string, b: string) {\n  return b.split(\"/\").length - a.split(\"/\").length;\n}\n\n// Returns true if path ends with a slash or **is empty**\nfunction hasTrailingSlash(path = \"/\") {\n  const lastChar = path[path.length - 1];\n  return lastChar === \"/\" || lastChar === \"\\\\\";\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/utils.gen.test.ts":{"tests":[{"id":"0","name":"normalizeAliases should sort aliases from specific to general and resolve nested aliases","location":{"start":{"column":3,"line":10}}},{"id":"1","name":"normalizeAliases should return the same object if already normalized","location":{"start":{"column":3,"line":22}}},{"id":"2","name":"normalizeAliases should resolve relative alias values that start with another alias correctly using path separators","location":{"start":{"column":3,"line":31}}},{"id":"3","name":"normalizeAliases should not resolve alias values when path separator requirement is missing","location":{"start":{"column":3,"line":43}}},{"id":"4","name":"resolveAlias should resolve @components/Button.ts to /app/src/components/Button.ts","location":{"start":{"column":5,"line":70}}},{"id":"5","name":"resolveAlias should resolve @/utils/index.ts to /app/src/utils/index.ts","location":{"start":{"column":5,"line":70}}},{"id":"6","name":"resolveAlias should resolve C:\\app\\src\\components\\Button.ts to C:/app/src/components/Button.ts","location":{"start":{"column":5,"line":70}}},{"id":"7","name":"resolveAlias should resolve @unmatched/file.ts to @unmatched/file.ts","location":{"start":{"column":5,"line":70}}},{"id":"8","name":"resolveAlias should handle alias with trailing slash when resolving paths","location":{"start":{"column":3,"line":75}}},{"id":"9","name":"reverseResolveAlias should return sorted possible alias resolutions","location":{"start":{"column":3,"line":89}}},{"id":"10","name":"reverseResolveAlias should return empty array when no alias matches","location":{"start":{"column":3,"line":94}}},{"id":"11","name":"reverseResolveAlias should handle trailing slash in alias during reverse resolution","location":{"start":{"column":3,"line":99}}},{"id":"12","name":"filename should extract filename for \"/path/to/file.ts\"","location":{"start":{"column":5,"line":119}}},{"id":"13","name":"filename should extract filename for \"C:\\\\path\\\\to\\\\file.d.ts\"","location":{"start":{"column":5,"line":119}}},{"id":"14","name":"filename should extract filename for \"/path/to/.gitignore\"","location":{"start":{"column":5,"line":119}}},{"id":"15","name":"filename should extract filename for \"file-only.js\"","location":{"start":{"column":5,"line":119}}},{"id":"16","name":"filename should extract filename for \"/path/to/\"","location":{"start":{"column":5,"line":119}}},{"id":"17","name":"filename should extract filename for \"\"","location":{"start":{"column":5,"line":119}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport {\n  normalizeAliases,\n  resolveAlias,\n  reverseResolveAlias,\n  filename\n} from \"../../src/utils\";\n\ndescribe(\"normalizeAliases\", () => {\n  it(\"should sort aliases from specific to general and resolve nested aliases\", () => {\n    const input = {\n      \"~/\": \"/root/\",\n      \"~/components\": \"/root/src/components\"\n    };\n    const result = normalizeAliases(input);\n    expect(result).toEqual({\n      \"~/components\": \"/root/src/components\",\n      \"~/\": \"/root/\"\n    });\n  });\n\n  it(\"should return the same object if already normalized\", () => {\n    const input = {\n      \"~/\": \"/root/\"\n    };\n    const normalized = normalizeAliases(input);\n    const reNormalized = normalizeAliases(normalized);\n    expect(reNormalized).toBe(normalized);\n  });\n\n  it(\"should resolve relative alias values that start with another alias correctly using path separators\", () => {\n    const input = {\n      \"@base\": \"/app\",\n      \"@components\": \"@base/components\"\n    };\n    const result = normalizeAliases(input);\n    expect(result).toEqual({\n      \"@components\": \"/app/components\",\n      \"@base\": \"/app\"\n    });\n  });\n\n  it(\"should not resolve alias values when path separator requirement is missing\", () => {\n    const input = {\n      \"@app\": \"/app\",\n      \"@apple\": \"@app/data\"\n    };\n    const result = normalizeAliases(input);\n    expect(result).toEqual({\n      \"@apple\": \"@app/data\",\n      \"@app\": \"/app\"\n    });\n  });\n});\n\ndescribe(\"resolveAlias\", () => {\n  const aliases = {\n    \"@\": \"/app/src\",\n    \"@components\": \"/app/src/components\"\n  };\n\n  const testCases = [\n    { path: \"@components/Button.ts\", expected: \"/app/src/components/Button.ts\" },\n    { path: \"@/utils/index.ts\", expected: \"/app/src/utils/index.ts\" },\n    { path: \"C:\\\\app\\\\src\\\\components\\\\Button.ts\", expected: \"C:/app/src/components/Button.ts\" },\n    { path: \"@unmatched/file.ts\", expected: \"@unmatched/file.ts\" }\n  ];\n\n  for (const { path, expected } of testCases) {\n    it(`should resolve ${path} to ${expected}`, () => {\n      expect(resolveAlias(path, aliases)).toBe(expected);\n    });\n  }\n\n  it(\"should handle alias with trailing slash when resolving paths\", () => {\n    const customAliases = {\n      \"@components/\": \"/app/src/components/\"\n    };\n    expect(resolveAlias(\"@components/Button.ts\", customAliases)).toBe(\"/app/src/components/Button.ts\");\n  });\n});\n\ndescribe(\"reverseResolveAlias\", () => {\n  const aliases = {\n    \"@\": \"/app/src\",\n    \"@components\": \"/app/src/components\"\n  };\n\n  it(\"should return sorted possible alias resolutions\", () => {\n    const result = reverseResolveAlias(\"/app/src/components/Button.ts\", aliases);\n    expect(result).toEqual([\"@/components/Button.ts\", \"@components/Button.ts\"]);\n  });\n\n  it(\"should return empty array when no alias matches\", () => {\n    const result = reverseResolveAlias(\"/other/path/file.ts\", aliases);\n    expect(result).toEqual([]);\n  });\n\n  it(\"should handle trailing slash in alias during reverse resolution\", () => {\n    const customAliases = {\n      \"@components/\": \"/app/src/comp