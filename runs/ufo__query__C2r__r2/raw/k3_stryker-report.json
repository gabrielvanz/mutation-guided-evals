boolean\n  | Array<QueryValue>\n  | Record<string, any>;\n\nexport type QueryObject = Record<string, QueryValue | QueryValue[]>;\n\nexport type ParsedQuery = Record<string, string | string[]>;\n\n// const EmptyObject = /* @__PURE__ */ (() => {\n//   const C = function () {};\n//   C.prototype = Object.create(null);\n//   return C;\n// })() as unknown as { new (): any };\n\n/**\n * Parses and decodes a query string into an object.\n *\n * The input can be a query string with or without the leading `?`.\n *\n * @example\n *\n * ```js\n * parseQuery(\"?foo=bar&baz=qux\");\n * // { foo: \"bar\", baz: \"qux\" }\n *\n * parseQuery(\"tags=javascript&tags=web&tags=dev\");\n * // { tags: [\"javascript\", \"web\", \"dev\"] }\n * ```\n *\n * @note\n * The `__proto__` and `constructor` keys are ignored to prevent prototype pollution.\n *\n * @group Query_utils\n */\nexport function parseQuery<T extends ParsedQuery = ParsedQuery>(\n  parametersString = \"\",\n): T {\n  // TODO: Use new EmptyObject() instead of Object.create(null) for better performance in next major version\n  // https://github.com/unjs/ufo/pull/290\n  const object: ParsedQuery = Object.create(null);\n  if (parametersString[0] === \"?\") {\n    parametersString = parametersString.slice(1);\n  }\n  for (const parameter of parametersString.split(\"&\")) {\n    const s = parameter.match(/([^=]+)=?(.*)/) || [];\n    if (s.length < 2) {\n      continue;\n    }\n    const key = decodeQueryKey(s[1]);\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n    const value = decodeQueryValue(s[2] || \"\");\n    if (object[key] === undefined) {\n      object[key] = value;\n    } else if (Array.isArray(object[key])) {\n      (object[key] as string[]).push(value);\n    } else {\n      object[key] = [object[key] as string, value];\n    }\n  }\n  return object as T;\n}\n\n/**\n * Encodes a pair of key and value into a url query string value.\n *\n * If the value is an array, it will be encoded as multiple key-value pairs with the same key.\n *\n * @example\n *\n * ```js\n * encodeQueryItem('message', 'Hello World')\n * // 'message=Hello+World'\n *\n * encodeQueryItem('tags', ['javascript', 'web', 'dev'])\n * // 'tags=javascript&tags=web&tags=dev'\n * ```\n *\n * @group Query_utils\n */\nexport function encodeQueryItem(\n  key: string,\n  value: QueryValue | QueryValue[],\n): string {\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    value = String(value);\n  }\n  if (!value) {\n    return encodeQueryKey(key);\n  }\n\n  if (Array.isArray(value)) {\n    return value\n      .map(\n        (_value: QueryValue) =>\n          `${encodeQueryKey(key)}=${encodeQueryValue(_value)}`,\n      )\n      .join(\"&\");\n  }\n\n  return `${encodeQueryKey(key)}=${encodeQueryValue(value)}`;\n}\n\n/**\n * Stringfies and encodes a query object into a query string.\n *\n * @example\n *\n * ```js\n * stringifyQuery({ foo: 'bar', baz: 'qux' })\n * // 'foo=bar&baz=qux'\n *\n * stringifyQuery({ foo: 'bar', baz: undefined })\n * // 'foo=bar'\n * ```\n *\n * @group Query_utils\n */\nexport function stringifyQuery(query: QueryObject): string {\n  return Object.keys(query)\n    .filter((k) => query[k] !== undefined)\n    .map((k) => encodeQueryItem(k, query[k]))\n    .filter(Boolean)\n    .join(\"&\");\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/query.gen.test.ts":{"tests":[{"id":"0","name":"parseQuery should parse a simple query string","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"parseQuery should parse a query string starting with '?'","location":{"start":{"column":3,"line":11}}},{"id":"2","name":"parseQuery should handle repeated keys as arrays","location":{"start":{"column":3,"line":17}}},{"id":"3","name":"parseQuery should handle omitted values or empty strings","location":{"start":{"column":3,"line":23}}},{"id":"4","name":"parseQuery should ignore empty parameters or malformed entries","location":{"start":{"column":3,"line":29}}},{"id":"5","name":"parseQuery should ignore __proto__ and constructor keys for security","location":{"start":{"column":3,"line":35}}},{"id":"6","name":"parseQuery should handle empty string input","location":{"start":{"column":3,"line":41}}},{"id":"7","name":"encodeQueryItem should encode 'message' with value 'Hello World'","location":{"start":{"column":14,"line":54}}},{"id":"8","name":"encodeQueryItem should encode 'num' with value 123","location":{"start":{"column":14,"line":54}}},{"id":"9","name":"encodeQueryItem should encode 'bool' with value true","location":{"start":{"column":14,"line":54}}},{"id":"10","name":"encodeQueryItem should encode 'empty' with value ''","location":{"start":{"column":14,"line":54}}},{"id":"11","name":"encodeQueryItem should encode 'tags' with value [ 'javascript', 'web' ]","location":{"start":{"column":14,"line":54}}},{"id":"12","name":"stringifyQuery should stringify a simple query object","location":{"start":{"column":3,"line":60}}},{"id":"13","name":"stringifyQuery should omit undefined values","location":{"start":{"column":3,"line":66}}},{"id":"14","name":"stringifyQuery should stringify arrays into repeated query items","location":{"start":{"column":3,"line":72}}},{"id":"15","name":"stringifyQuery should handle numbers and booleans","location":{"start":{"column":3,"line":78}}},{"id":"16","name":"stringifyQuery should handle empty query object","location":{"start":{"column":3,"line":84}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { parseQuery, encodeQueryItem, stringifyQuery } from \"../../src/query\";\n\ndescribe(\"parseQuery\", () => {\n  it(\"should parse a simple query string\", () => {\n    const input = \"foo=bar&baz=qux\";\n    const expected = { foo: \"bar\", baz: \"qux\" };\n    expect(parseQuery(input)).toEqual(expected);\n  });\n\n  it(\"should parse a query string starting with '?'\", () => {\n    const input = \"?foo=bar&baz=qux\";\n    const expected = { foo: \"bar\", baz: \"qux\" };\n    expect(parseQuery(input)).toEqual(expected);\n  });\n\n  it(\"should handle repeated keys as arrays\", () => {\n    const input = \"tags=javascript&tags=web&tags=dev\";\n    const expected = { tags: [\"javascript\", \"web\", \"dev\"] };\n    expect(parseQuery(input)).toEqual(expected);\n  });\n\n  it(\"should handle omitted values or empty strings\", () => {\n    const input = \"foo=&bar\";\n    const expected = { foo: \"\", bar: \"\" };\n    expect(parseQuery(input)).toEqual(expected);\n  });\n\n  it(\"should ignore empty parameters or malformed entries\", () => {\n    const input = \"&&foo=bar&&\";\n    const expected = { foo: \"bar\" };\n    expect(parseQuery(input)).toEqual(expected);\n  });\n\n  it(\"should ignore __proto__ and constructor keys for security\", () => {\n    const input = \"__proto__=bar&constructor=bad&safe=good\";\n    const expected = { safe: \"good\" };\n    expect(parseQuery(input)).toEqual(expected);\n  });\n\n  it(\"should handle empty string input\", () => {\n    expect(parseQuery(\"\")).toEqual({});\n    expect(parseQuery()).toEqual({});\n  });\n});\n\ndescribe(\"encodeQueryItem\", () => {\n  it.each([\n    { key: \"message\", value: \"Hello World\", expected: \"message=Hello+World\" },\n    { key: \"num\", value: 123, expected: \"num=123\" },\n    { key: \"bool\", value: true, expected: \"bool=true\" },\n    { key: \"empty\", value: \"\", expected: \"empty\" },\n    { key: \"tags\", value: [\"javascript\", \"web\"], expected: \"tags=javascript&tags=web\" },\n  ] as const)(\"should encode $key with value $value\", ({ key, value, expected }) => {\n    expect(encodeQueryItem(key, value)).toBe(expected);\n  });\n});\n\ndescribe(\"stringifyQuery\", () => {\n  it(\"should stringify a simple query object\", () => {\n    const input = { foo: \"bar\", baz: \"qux\" };\n    const expected = \"foo=bar&baz=qux\";\n    expect(stringifyQuery(input)).toBe(expected);\n  });\n\n  it(\"should omit undefined values\", () => {\n    const input = { foo: \"bar\", baz: undefined };\n    const expected = \"foo=bar\";\n    expect(stringifyQuery(input)).toBe(expected);\n  });\n\n  it(\"should stringify arrays into repeated query items\", () => {\n    const input = { tags: [\"javascript\", \"web\", \"dev\"] };\n    const expected = \"tags=javascript&tags=web&tags=dev\";\n    expect(stringifyQuery(input)).toBe(expected);\n  });\n\n  it(\"should handle numbers and booleans\", () => {\n    const input = { count: 5, active: true };\n    const expected = \"count=5&active=true\";\n    expect(stringifyQuery(input)).toBe(expected);\n  });\n\n  it(\"should handle empty query object\", () => {\n    expect(stringifyQuery({})).toBe(\"\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/query.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/ufo__query__C2r__r2/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true,"pool":"threads"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"logLevel":"info","maxConcurrentTestRunners":9007199254740991,"maxTestRunnerReuse":0,