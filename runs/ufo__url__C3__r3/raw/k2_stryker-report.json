"duration":4.214832999999999,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":77,"line":126},"start":{"column":9,"line":126}}},{"id":"88","mutatorName":"ConditionalExpression","replacement":"false","statusReason":"expected '' to be '#newhash' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.039383000000271,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":17,"line":129},"start":{"column":9,"line":129}}},{"id":"89","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected '' to be '#newhash' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.793843000000379,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":6,"line":131},"start":{"column":19,"line":129}}},{"id":"91","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'https://example.com/path?foo=bar#hash' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.851705000000038,"killedBy":["0"],"coveredBy":["0"],"location":{"end":{"column":4,"line":140},"start":{"column":22,"line":138}}},{"id":"90","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'https://example.com/path?foo=bar#hash' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":5.897603999999774,"killedBy":["0"],"coveredBy":["0"],"location":{"end":{"column":4,"line":136},"start":{"column":20,"line":134}}},{"id":"92","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be an instance of $URL","status":"Killed","static":false,"testsCompleted":1,"duration":2.243464000000131,"killedBy":["8"],"coveredBy":["8"],"location":{"end":{"column":2,"line":148},"start":{"column":48,"line":146}}}],"source":"import { parseURL, parseAuth, parseHost } from \"./parse\";\nimport { QueryObject, parseQuery, stringifyQuery } from \"./query\";\nimport { withoutLeadingSlash, withTrailingSlash } from \"./utils\";\nimport {\n  encodeHash,\n  encodePath,\n  decodePath,\n  decode,\n  encodeHost,\n} from \"./encoding\";\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport class $URL implements URL {\n  protocol: string;\n  host: string;\n  auth: string;\n  pathname: string;\n  query: QueryObject = {};\n  hash: string;\n\n  constructor(input = \"\") {\n    if (typeof input !== \"string\") {\n      throw new TypeError(\n        `URL input should be string received ${typeof input} (${input})`,\n      );\n    }\n\n    const parsed = parseURL(input);\n\n    this.protocol = decode(parsed.protocol);\n    this.host = decode(parsed.host);\n    this.auth = decode(parsed.auth);\n    this.pathname = decodePath(parsed.pathname);\n    this.query = parseQuery(parsed.search);\n    this.hash = decode(parsed.hash);\n  }\n\n  get hostname(): string {\n    return parseHost(this.host).hostname;\n  }\n\n  get port(): string {\n    return parseHost(this.host).port || \"\";\n  }\n\n  get username(): string {\n    return parseAuth(this.auth).username;\n  }\n\n  get password(): string {\n    return parseAuth(this.auth).password || \"\";\n  }\n\n  get hasProtocol() {\n    return this.protocol.length;\n  }\n\n  get isAbsolute() {\n    return this.hasProtocol || this.pathname[0] === \"/\";\n  }\n\n  get search(): string {\n    const q = stringifyQuery(this.query);\n    return q.length > 0 ? \"?\" + q : \"\";\n  }\n\n  get searchParams(): URLSearchParams {\n    const p = new URLSearchParams();\n    for (const name in this.query) {\n      const value = this.query[name];\n      if (Array.isArray(value)) {\n        for (const v of value) {\n          p.append(name, v);\n        }\n      } else {\n        p.append(\n          name,\n          typeof value === \"string\" ? value : JSON.stringify(value),\n        );\n      }\n    }\n    return p;\n  }\n\n  get origin(): string {\n    return (this.protocol ? this.protocol + \"//\" : \"\") + encodeHost(this.host);\n  }\n\n  get fullpath(): string {\n    return encodePath(this.pathname) + this.search + encodeHash(this.hash);\n  }\n\n  get encodedAuth(): string {\n    if (!this.auth) {\n      return \"\";\n    }\n    const { username, password } = parseAuth(this.auth);\n    return (\n      encodeURIComponent(username) +\n      (password ? \":\" + encodeURIComponent(password) : \"\")\n    );\n  }\n\n  get href(): string {\n    const auth = this.encodedAuth;\n    const originWithAuth =\n      (this.protocol ? this.protocol + \"//\" : \"\") +\n      (auth ? auth + \"@\" : \"\") +\n      encodeHost(this.host);\n    return this.hasProtocol && this.isAbsolute\n      ? originWithAuth + this.fullpath\n      : this.fullpath;\n  }\n\n  append(url: $URL) {\n    if (url.hasProtocol) {\n      throw new Error(\"Cannot append a URL with protocol\");\n    }\n\n    Object.assign(this.query, url.query);\n\n    if (url.pathname) {\n      this.pathname =\n        withTrailingSlash(this.pathname) + withoutLeadingSlash(url.pathname);\n    }\n\n    if (url.hash) {\n      this.hash = url.hash;\n    }\n  }\n\n  toJSON(): string {\n    return this.href;\n  }\n\n  toString(): string {\n    return this.href;\n  }\n}\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport function createURL(input: string): $URL {\n  return new $URL(input);\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/url.gen.test.ts":{"tests":[{"id":"0","name":"$URL should parse absolute URL with protocol, host, pathname, query and hash","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"$URL should handle empty input default value","location":{"start":{"column":3,"line":24}}},{"id":"2","name":"$URL should throw TypeError for non-string input","location":{"start":{"column":3,"line":34}}},{"id":"3","name":"$URL should correctly parse port and hostname","location":{"start":{"column":3,"line":39}}},{"id":"4","name":"$URL should correctly parse username and password","location":{"start":{"column":3,"line":46}}},{"id":"5","name":"$URL should handle array query parameters in searchParams","location":{"start":{"column":3,"line":53}}},{"id":"6","name":"$URL should append a relative URL without protocol","location":{"start":{"column":3,"line":60}}},{"id":"7","name":"$URL should throw error when appending a URL with protocol","location":{"start":{"column":3,"line":69}}},{"id":"8","name":"createURL should create an instance of $URL","location":{"start":{"column":3,"line":77}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { $URL, createURL } from \"../../src/url\";\n\ndescribe(\"$URL\", () => {\n  it(\"should parse absolute URL with protocol, host, pathname, query and hash\", () => {\n    const url = new $URL(\"https://example.com/path?foo=bar#hash\");\n    expect(url.protocol).toBe(\"https:\");\n    expect(url.host).toBe(\"example.com\");\n    expect(url.pathname).toBe(\"/path\");\n    expect(url.query).toEqual({ foo: \"bar\" });\n    expect(url.hash).toBe(\"#hash\");\n    expect(url.hostname).toBe(\"example.com\");\n    expect(url.port).toBe(\"\");\n    expect(url.hasProtocol).toBe(6);\n    expect(url.isAbsolute).toBe(6);\n    expect(url.search).toBe(\"?foo=bar\");\n    expect(url.origin).toBe(\"https://example.com\");\n    expect(url.fullpath).toBe(\"/path?foo=bar#hash\");\n    expect(url.href).toBe(\"https://example.com/path?foo=bar#hash\");\n    expect(url.toString()).toBe(\"https://example.com/path?foo=bar#hash\");\n    expect(url.toJSON()).toBe(\"https://example.com/path?foo=bar#hash\");\n  });\n\n  it(\"should handle empty input default value\", () => {\n    const url = new $URL();\n    expect(url.protocol).toBe(\"\");\n    expect(url.host).toBe(\"\");\n    expect(url.pathname).toBe(\"\");\n    expect(url.query).toEqual({});\n    expect(url.hash).toBe(\"\");\n    expect(url.href).toBe(\"\");\n  });\n\n  it(\"should throw TypeError for non-string input\", () => {\n    expect(() => new $URL(123 as any)).toThrow(TypeError);\n    expect(() => new $URL(123 as any)).toThrow(\"URL input should be string received number (123)\");\n  });\n\n  it(\"should correctly parse port and hostname\", () => {\n    const url = new $URL(\"http://localhost:8080/api\");\n    expect(url.hostname).toBe(\"localhost\");\n    expect(url.port).toBe(\"8080\");\n    expect(url.origin).toBe(\"http://localhost:8080\");\n  });\n\n  it(\"should correctly parse username and password\", () => {\n    const url = new $URL(\"https://user:pass@example.com/\");\n    expect(url.username).toBe(\"user\");\n    expect(url.password).toBe(\"pass\");\n    expect(url.encodedAuth).toBe(\"user:pass\");\n  });\n\n  it(\"should handle array query parameters in searchParams\", () => {\n    const url = new $URL(\"https://example.com/?tag=a&tag=b&num=1\");\n    const params = url.searchParams;\n    expect(params.getAll(\"tag\")).toEqual([\"a\", \"b\"]);\n    expect(params.get(\"num\")).toBe(\"1\");\n  });\n\n  it(\"should append a relative URL without protocol\", () => {\n    const base = new $URL(\"https://example.com/base/\");\n    const extra = new $URL(\"sub?new=1#newhash\");\n    base.append(extra);\n    expect(base.pathname).toBe(\"/base/sub\");\n    expect(base.query).toEqual({ new: \"1\" });\n    expect(base.hash).toBe(\"#newhash\");\n  });\n\n  it(\"should throw error when appending a URL with protocol\", () => {\n    const base = new $URL(\"https://example.com/\");\n    const other = new $URL(\"https://other.com/\");\n    expect(() => base.append(other)).toThrow(\"Cannot append a URL with protocol\");\n  });\n});\n\ndescribe(\"createURL\", () => {\n  it(\"should create an instance of $URL\", () => {\n    const url = createURL(\"https://example.com\");\n    expect(url).toBeInstanceOf($URL);\n    expect(url.href).toBe(\"https://example.com\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":[