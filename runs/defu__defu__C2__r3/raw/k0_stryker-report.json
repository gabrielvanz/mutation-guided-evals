:73,"line":65}}},{"id":"66","mutatorName":"BooleanLiteral","replacement":"false","statusReason":"expected { arr: [Function arr] } to deeply equal { arr: [ 1, 2, 3 ] }","status":"Killed","static":false,"testsCompleted":1,"duration":4.47262099999989,"killedBy":["9"],"coveredBy":["9"],"location":{"end":{"column":16,"line":67},"start":{"column":12,"line":67}}},{"id":"43","mutatorName":"BlockStatement","replacement":"{}","statusReason":"defu is not a function","status":"Killed","static":true,"testsCompleted":1,"duration":1.5633150000003297,"killedBy":["0"],"coveredBy":["7"],"location":{"end":{"column":2,"line":49},"start":{"column":59,"line":45}}},{"id":"44","mutatorName":"ArrowFunction","replacement":"() => undefined","statusReason":"expected undefined to deeply equal { a: 1, b: 2, c: 4 }","status":"Killed","static":true,"testsCompleted":1,"duration":3.0332979999993768,"killedBy":["0"],"coveredBy":["7"],"location":{"end":{"column":68,"line":48},"start":{"column":10,"line":46}}}],"source":"import { isPlainObject } from \"./_utils\";\nimport type { Merger, DefuFn as DefuFunction, DefuInstance } from \"./types\";\n\n// Base function to apply defaults\nfunction _defu<T>(baseObject: T, defaults: any, namespace = \".\", merger?: Merger): T {\n  if (!isPlainObject(defaults)) {\n    return _defu(baseObject, {}, namespace, merger);\n  }\n\n  const object = { ...defaults };\n\n  for (const key of Object.keys(baseObject as Record<string, any>)) {\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n\n    const value = (baseObject as Record<string, any>)[key];\n\n    if (value === null || value === undefined) {\n      continue;\n    }\n\n    if (merger && merger(object, key, value, namespace)) {\n      continue;\n    }\n\n    if (Array.isArray(value) && Array.isArray(object[key])) {\n      object[key] = [...value, ...object[key]];\n    } else if (isPlainObject(value) && isPlainObject(object[key])) {\n      object[key] = _defu(\n        value,\n        object[key],\n        (namespace ? `${namespace}.` : \"\") + key.toString(),\n        merger,\n      );\n    } else {\n      object[key] = value;\n    }\n  }\n\n  return object;\n}\n\n// Create defu wrapper with optional merger and multi arg support\nexport function createDefu(merger?: Merger): DefuFunction {\n  return (...arguments_) =>\n    // eslint-disable-next-line unicorn/no-array-reduce\n    arguments_.reduce((p, c) => _defu(p, c, \"\", merger), {} as any);\n}\n\n// Standard version\nexport const defu = createDefu() as DefuInstance;\nexport default defu;\n\n// Custom version with function merge support\nexport const defuFn = createDefu((object, key, currentValue) => {\n  if (object[key] !== undefined && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\n// Custom version with function merge support only for defined arrays\nexport const defuArrayFn = createDefu((object, key, currentValue) => {\n  if (Array.isArray(object[key]) && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\nexport type { Defu, DefuFn, DefuInstance } from \"./types\";\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/defu.gen.test.ts":{"tests":[{"id":"0","name":"defu should merge basic objects","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"defu should handle multiple arguments","location":{"start":{"column":3,"line":12}}},{"id":"2","name":"defu should ignore null and undefined in base object","location":{"start":{"column":3,"line":17}}},{"id":"3","name":"defu should concatenate arrays","location":{"start":{"column":3,"line":24}}},{"id":"4","name":"defu should recursively merge plain objects","location":{"start":{"column":3,"line":31}}},{"id":"5","name":"defu should ignore __proto__ and constructor keys","location":{"start":{"column":3,"line":38}}},{"id":"6","name":"defu should handle non-plain object defaults gracefully","location":{"start":{"column":3,"line":46}}},{"id":"7","name":"createDefu should create a custom defu instance with a custom merger","location":{"start":{"column":3,"line":54}}},{"id":"8","name":"defuFn should merge using functions","location":{"start":{"column":3,"line":68}}},{"id":"9","name":"defuArrayFn should execute function when default is an array","location":{"start":{"column":3,"line":81}}},{"id":"10","name":"defuArrayFn should not execute function when default is not an array","location":{"start":{"column":3,"line":92}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { defu, createDefu, defuFn, defuArrayFn } from \"../../src/defu\";\n\ndescribe(\"defu\", () => {\n  it(\"should merge basic objects\", () => {\n    const base = { a: 1, b: 2 };\n    const defaults = { b: 3, c: 4 };\n    const result = defu(base, defaults);\n    expect(result).toEqual({ a: 1, b: 2, c: 4 });\n  });\n\n  it(\"should handle multiple arguments\", () => {\n    const result = defu({ a: 1 }, { b: 2 }, { c: 3 }, { a: 10 });\n    expect(result).toEqual({ a: 1, b: 2, c: 3 });\n  });\n\n  it(\"should ignore null and undefined in base object\", () => {\n    const base = { a: null, b: undefined, c: 3 };\n    const defaults = { a: 1, b: 2, c: 4 };\n    const result = defu(base, defaults);\n    expect(result).toEqual({ a: 1, b: 2, c: 3 });\n  });\n\n  it(\"should concatenate arrays\", () => {\n    const base = { arr: [1, 2] };\n    const defaults = { arr: [3, 4] };\n    const result = defu(base, defaults);\n    expect(result).toEqual({ arr: [1, 2, 3, 4] });\n  });\n\n  it(\"should recursively merge plain objects\", () => {\n    const base = { nested: { a: 1, c: { x: 10 } } };\n    const defaults = { nested: { a: 2, b: 3, c: { y: 20 } } };\n    const result = defu(base, defaults);\n    expect(result).toEqual({ nested: { a: 1, b: 3, c: { x: 10, y: 20 } } });\n  });\n\n  it(\"should ignore __proto__ and constructor keys\", () => {\n    const base = JSON.parse('{\"__proto__\": {\"polluted\": true}, \"constructor\": {\"prototype\": {\"polluted\": true}}, \"a\": 1}');\n    const defaults = { a: 2, b: 3 };\n    const result = defu(base, defaults);\n    expect(result).toEqual({ a: 1, b: 3 });\n    expect(({} as any).polluted).toBeUndefined();\n  });\n\n  it(\"should handle non-plain object defaults gracefully\", () => {\n    const base = { a: 1 };\n    const result = defu(base, null as any);\n    expect(result).toEqual({ a: 1 });\n  });\n});\n\ndescribe(\"createDefu\", () => {\n  it(\"should create a custom defu instance with a custom merger\", () => {\n    const custom = createDefu((object, key, value) => {\n      if (key === \"special\") {\n        object[key] = `custom-${value}`;\n        return true;\n      }\n    });\n\n    const result = custom({ special: \"value\" }, { special: \"default\" });\n    expect(result).toEqual({ special: \"custom-value\" });\n  });\n});\n\ndescribe(\"defuFn\", () => {\n  it(\"should merge using functions\", () => {\n    const base = {\n      callback: (val: number) => val + 1,\n    };\n    const defaults = {\n      callback: 10,\n    };\n    const result = defuFn(base, defaults);\n    expect(result).toEqual({ callback: 11 });\n  });\n});\n\ndescribe(\"defuArrayFn\", () => {\n  it(\"should execute function when default is an array\", () => {\n    const base = {\n      arr: (val: number[]) => [...val, 3],\n    };\n    const defaults = {\n      arr: [1, 2],\n    };\n    const result = defuArrayFn(base, defaults);\n    expect(result).toEqual({ arr: [1, 2, 3] });\n  });\n\n  it(\"should not execute function when default is not an array\", () => {\n    const base = {\n      arr: (val: any) => val,\n    };\n    const defaults = {\n      arr: \"not-an-array\",\n    };\n    const result = defuArrayFn(base, defaults);\n    expect(typeof result.arr).toBe(\"function\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/defu","config":{"testRunner":"vitest","plugins":["@stryk