atus":"Killed","static":false,"testsCompleted":1,"duration":4.650345999999445,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":6,"line":131},"start":{"column":19,"line":129}}},{"id":"90","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'https://example.com:8080/path/to/page…' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.995222999999896,"killedBy":["0"],"coveredBy":["0"],"location":{"end":{"column":4,"line":136},"start":{"column":20,"line":134}}},{"id":"91","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'https://example.com:8080/path/to/page…' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.906039000000419,"killedBy":["0"],"coveredBy":["0"],"location":{"end":{"column":4,"line":140},"start":{"column":22,"line":138}}},{"id":"92","mutatorName":"BlockStatement","replacement":"{}","statusReason":"Cannot read properties of undefined (reading 'protocol')","status":"Killed","static":false,"testsCompleted":1,"duration":1.17962499999976,"killedBy":["1"],"coveredBy":["1"],"location":{"end":{"column":2,"line":148},"start":{"column":48,"line":146}}}],"source":"import { parseURL, parseAuth, parseHost } from \"./parse\";\nimport { QueryObject, parseQuery, stringifyQuery } from \"./query\";\nimport { withoutLeadingSlash, withTrailingSlash } from \"./utils\";\nimport {\n  encodeHash,\n  encodePath,\n  decodePath,\n  decode,\n  encodeHost,\n} from \"./encoding\";\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport class $URL implements URL {\n  protocol: string;\n  host: string;\n  auth: string;\n  pathname: string;\n  query: QueryObject = {};\n  hash: string;\n\n  constructor(input = \"\") {\n    if (typeof input !== \"string\") {\n      throw new TypeError(\n        `URL input should be string received ${typeof input} (${input})`,\n      );\n    }\n\n    const parsed = parseURL(input);\n\n    this.protocol = decode(parsed.protocol);\n    this.host = decode(parsed.host);\n    this.auth = decode(parsed.auth);\n    this.pathname = decodePath(parsed.pathname);\n    this.query = parseQuery(parsed.search);\n    this.hash = decode(parsed.hash);\n  }\n\n  get hostname(): string {\n    return parseHost(this.host).hostname;\n  }\n\n  get port(): string {\n    return parseHost(this.host).port || \"\";\n  }\n\n  get username(): string {\n    return parseAuth(this.auth).username;\n  }\n\n  get password(): string {\n    return parseAuth(this.auth).password || \"\";\n  }\n\n  get hasProtocol() {\n    return this.protocol.length;\n  }\n\n  get isAbsolute() {\n    return this.hasProtocol || this.pathname[0] === \"/\";\n  }\n\n  get search(): string {\n    const q = stringifyQuery(this.query);\n    return q.length > 0 ? \"?\" + q : \"\";\n  }\n\n  get searchParams(): URLSearchParams {\n    const p = new URLSearchParams();\n    for (const name in this.query) {\n      const value = this.query[name];\n      if (Array.isArray(value)) {\n        for (const v of value) {\n          p.append(name, v);\n        }\n      } else {\n        p.append(\n          name,\n          typeof value === \"string\" ? value : JSON.stringify(value),\n        );\n      }\n    }\n    return p;\n  }\n\n  get origin(): string {\n    return (this.protocol ? this.protocol + \"//\" : \"\") + encodeHost(this.host);\n  }\n\n  get fullpath(): string {\n    return encodePath(this.pathname) + this.search + encodeHash(this.hash);\n  }\n\n  get encodedAuth(): string {\n    if (!this.auth) {\n      return \"\";\n    }\n    const { username, password } = parseAuth(this.auth);\n    return (\n      encodeURIComponent(username) +\n      (password ? \":\" + encodeURIComponent(password) : \"\")\n    );\n  }\n\n  get href(): string {\n    const auth = this.encodedAuth;\n    const originWithAuth =\n      (this.protocol ? this.protocol + \"//\" : \"\") +\n      (auth ? auth + \"@\" : \"\") +\n      encodeHost(this.host);\n    return this.hasProtocol && this.isAbsolute\n      ? originWithAuth + this.fullpath\n      : this.fullpath;\n  }\n\n  append(url: $URL) {\n    if (url.hasProtocol) {\n      throw new Error(\"Cannot append a URL with protocol\");\n    }\n\n    Object.assign(this.query, url.query);\n\n    if (url.pathname) {\n      this.pathname =\n        withTrailingSlash(this.pathname) + withoutLeadingSlash(url.pathname);\n    }\n\n    if (url.hash) {\n      this.hash = url.hash;\n    }\n  }\n\n  toJSON(): string {\n    return this.href;\n  }\n\n  toString(): string {\n    return this.href;\n  }\n}\n\n/**\n * @deprecated use native URL with `new URL(input)` or `ufo.parseURL(input)`\n */\nexport function createURL(input: string): $URL {\n  return new $URL(input);\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/url.gen.test.ts":{"tests":[{"id":"0","name":"$URL and createURL should parse an absolute URL correctly","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"$URL and createURL should parse a relative URL correctly","location":{"start":{"column":3,"line":23}}},{"id":"2","name":"$URL and createURL should parse auth, username, and password correctly","location":{"start":{"column":3,"line":33}}},{"id":"3","name":"$URL and createURL should handle searchParams correctly with array values","location":{"start":{"column":3,"line":42}}},{"id":"4","name":"$URL and createURL should throw a TypeError for non-string input","location":{"start":{"column":3,"line":48}}},{"id":"5","name":"$URL and createURL should append a relative URL correctly","location":{"start":{"column":3,"line":52}}},{"id":"6","name":"$URL and createURL should throw an error when appending a URL with a protocol","location":{"start":{"column":3,"line":63}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport { $URL, createURL } from \"../../src/url\";\n\ndescribe(\"$URL and createURL\", () => {\n  it(\"should parse an absolute URL correctly\", () => {\n    const url = new $URL(\"https://example.com:8080/path/to/page?foo=bar#hash\");\n    expect(url.protocol).toBe(\"https:\");\n    expect(url.host).toBe(\"example.com:8080\");\n    expect(url.hostname).toBe(\"example.com\");\n    expect(url.port).toBe(\"8080\");\n    expect(url.pathname).toBe(\"/path/to/page\");\n    expect(url.query).toEqual({ foo: \"bar\" });\n    expect(url.hash).toBe(\"#hash\");\n    expect(url.search).toBe(\"?foo=bar\");\n    expect(url.hasProtocol).toBeTruthy();\n    expect(url.isAbsolute).toBeTruthy();\n    expect(url.origin).toBe(\"https://example.com:8080\");\n    expect(url.href).toBe(\"https://example.com:8080/path/to/page?foo=bar#hash\");\n    expect(url.toString()).toBe(\"https://example.com:8080/path/to/page?foo=bar#hash\");\n    expect(url.toJSON()).toBe(\"https://example.com:8080/path/to/page?foo=bar#hash\");\n  });\n\n  it(\"should parse a relative URL correctly\", () => {\n    const url = createURL(\"/relative/path?a=1\");\n    expect(url.protocol).toBe(\"\");\n    expect(url.pathname).toBe(\"/relative/path\");\n    expect(url.query).toEqual({ a: \"1\" });\n    expect(url.hasProtocol).toBeFalsy();\n    expect(url.isAbsolute).toBeTruthy();\n    expect(url.href).toBe(\"/relative/path?a=1\");\n  });\n\n  it(\"should parse auth, username, and password correctly\", () => {\n    const url = new $URL(\"https://user:pass@example.com\");\n    expect(url.auth).toBe(\"user:pass\");\n    expect(url.username).toBe(\"user\");\n    expect(url.password).toBe(\"pass\");\n    expect(url.encodedAuth).toBe(\"user:pass\");\n    expect(url.href).toBe(\"https://user:pass@example.com\");\n  });\n\n  it(\"should handle searchParams correctly with array values\", () => {\n    const url = new $URL(\"https://example.com/?tag=a&tag=b\");\n    const params = url.searchParams;\n    expect(params.getAll(\"tag\")).toEqual([\"a\", \"b\"]);\n  });\n\n  it(\"should throw a TypeError for non-string input\", () => {\n    expect(() => new $URL(123 as unknown as string)).toThrowError(TypeError);\n  });\n\n  it(\"should append a relative URL correctly\", () => {\n    const base = new $URL(\"https://example.com/base/\");\n    const extra = new $URL(\"sub?query=1#newhash\");\n\n    base.append(extra);\n\n    expect(base.pathname).toBe(\"/base/sub\");\n    expect(base.query).toEqual({ query: \"1\" });\n    expect(base.hash).toBe(\"#newhash\");\n  });\n\n  it(\"should throw an error when appending a URL with a protocol\", () => {\n    const base = new $URL(\"https://example.com/base/\");\n    const extra = new $URL(\"https://other.com/sub\");\n\n    expect(() => base.append(extra)).toThrowError(\"Cannot append a URL with protocol\");\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/ufo","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/url.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/ufo__url__C1__r2/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true,"pool":"threads"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"logLevel":"info","maxConcurrentTestRunners":9007199254740991,"maxTestRunnerReuse":0,"mu