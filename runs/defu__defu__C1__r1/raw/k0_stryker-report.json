ndefined to deeply equal { a: 1, b: 3 }","status":"Killed","static":true,"testsCompleted":2,"duration":4.101942000000236,"killedBy":["1"],"coveredBy":["10"],"location":{"end":{"column":68,"line":48},"start":{"column":10,"line":46}}}],"source":"import { isPlainObject } from \"./_utils\";\nimport type { Merger, DefuFn as DefuFunction, DefuInstance } from \"./types\";\n\n// Base function to apply defaults\nfunction _defu<T>(baseObject: T, defaults: any, namespace = \".\", merger?: Merger): T {\n  if (!isPlainObject(defaults)) {\n    return _defu(baseObject, {}, namespace, merger);\n  }\n\n  const object = { ...defaults };\n\n  for (const key of Object.keys(baseObject as Record<string, any>)) {\n    if (key === \"__proto__\" || key === \"constructor\") {\n      continue;\n    }\n\n    const value = (baseObject as Record<string, any>)[key];\n\n    if (value === null || value === undefined) {\n      continue;\n    }\n\n    if (merger && merger(object, key, value, namespace)) {\n      continue;\n    }\n\n    if (Array.isArray(value) && Array.isArray(object[key])) {\n      object[key] = [...value, ...object[key]];\n    } else if (isPlainObject(value) && isPlainObject(object[key])) {\n      object[key] = _defu(\n        value,\n        object[key],\n        (namespace ? `${namespace}.` : \"\") + key.toString(),\n        merger,\n      );\n    } else {\n      object[key] = value;\n    }\n  }\n\n  return object;\n}\n\n// Create defu wrapper with optional merger and multi arg support\nexport function createDefu(merger?: Merger): DefuFunction {\n  return (...arguments_) =>\n    // eslint-disable-next-line unicorn/no-array-reduce\n    arguments_.reduce((p, c) => _defu(p, c, \"\", merger), {} as any);\n}\n\n// Standard version\nexport const defu = createDefu() as DefuInstance;\nexport default defu;\n\n// Custom version with function merge support\nexport const defuFn = createDefu((object, key, currentValue) => {\n  if (object[key] !== undefined && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\n// Custom version with function merge support only for defined arrays\nexport const defuArrayFn = createDefu((object, key, currentValue) => {\n  if (Array.isArray(object[key]) && typeof currentValue === \"function\") {\n    object[key] = currentValue(object[key]);\n    return true;\n  }\n});\n\nexport type { Defu, DefuFn, DefuInstance } from \"./types\";\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/defu.gen.test.ts":{"tests":[{"id":"0","name":"defu exports defu as both named and default export","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"defu merges basic objects with left-most priority","location":{"start":{"column":3,"line":9}}},{"id":"2","name":"defu merges multiple objects in order of priority","location":{"start":{"column":3,"line":14}}},{"id":"3","name":"defu ignores null and undefined values in source","location":{"start":{"column":3,"line":19}}},{"id":"4","name":"defu recursively merges nested plain objects","location":{"start":{"column":3,"line":27}}},{"id":"5","name":"defu concatenates arrays with source elements first","location":{"start":{"column":3,"line":37}}},{"id":"6","name":"defu overwrites non-array with array and vice versa","location":{"start":{"column":3,"line":42}}},{"id":"7","name":"defu handles non-plain-object defaults gracefully","location":{"start":{"column":3,"line":47}}},{"id":"8","name":"defu does not mutate input objects","location":{"start":{"column":3,"line":53}}},{"id":"9","name":"defu prevents prototype pollution via __proto__ and constructor","location":{"start":{"column":3,"line":63}}},{"id":"10","name":"createDefu uses custom merger and passes correct namespace","location":{"start":{"column":3,"line":73}}},{"id":"11","name":"defuFn calls function with default value when default is defined","location":{"start":{"column":3,"line":94}}},{"id":"12","name":"defuFn keeps function as-is when default is undefined","location":{"start":{"column":3,"line":112}}},{"id":"13","name":"defuArrayFn calls function only when default value is an array","location":{"start":{"column":3,"line":120}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport defuDefault, { defu, createDefu, defuFn, defuArrayFn } from \"../../src/defu\";\n\ndescribe(\"defu\", () => {\n  it(\"exports defu as both named and default export\", () => {\n    expect(defuDefault).toBe(defu);\n  });\n\n  it(\"merges basic objects with left-most priority\", () => {\n    const result = defu({ a: 1 }, { a: 2, b: 3 });\n    expect(result).toEqual({ a: 1, b: 3 });\n  });\n\n  it(\"merges multiple objects in order of priority\", () => {\n    const result = defu({ a: 1 }, { a: 2, b: 2 }, { a: 3, b: 3, c: 3 });\n    expect(result).toEqual({ a: 1, b: 2, c: 3 });\n  });\n\n  it(\"ignores null and undefined values in source\", () => {\n    const result = defu(\n      { a: null, b: undefined, c: 0, d: false, e: \"\" },\n      { a: 1, b: 2, c: 3, d: true, e: \"default\" },\n    );\n    expect(result).toEqual({ a: 1, b: 2, c: 0, d: false, e: \"\" });\n  });\n\n  it(\"recursively merges nested plain objects\", () => {\n    const result = defu(\n      { nested: { a: 1, deep: { x: 10 } } },\n      { nested: { a: 2, b: 3, deep: { x: 20, y: 30 } } },\n    );\n    expect(result).toEqual({\n      nested: { a: 1, b: 3, deep: { x: 10, y: 30 } },\n    });\n  });\n\n  it(\"concatenates arrays with source elements first\", () => {\n    const result = defu({ arr: [1, 2] }, { arr: [3, 4] });\n    expect(result).toEqual({ arr: [1, 2, 3, 4] });\n  });\n\n  it(\"overwrites non-array with array and vice versa\", () => {\n    expect(defu({ a: [1, 2] }, { a: \"str\" })).toEqual({ a: [1, 2] });\n    expect(defu({ a: \"str\" }, { a: [1, 2] })).toEqual({ a: \"str\" });\n  });\n\n  it(\"handles non-plain-object defaults gracefully\", () => {\n    expect(defu({ a: 1 }, null as any)).toEqual({ a: 1 });\n    expect(defu({ a: 1 }, undefined as any)).toEqual({ a: 1 });\n    expect(defu({ a: 1 }, 42 as any)).toEqual({ a: 1 });\n  });\n\n  it(\"does not mutate input objects\", () => {\n    const source = { a: 1, nested: { x: 1 } };\n    const defaults = { a: 2, b: 3, nested: { x: 2, y: 2 } };\n    const result = defu(source, defaults);\n\n    expect(result).toEqual({ a: 1, b: 3, nested: { x: 1, y: 2 } });\n    expect(source).toEqual({ a: 1, nested: { x: 1 } });\n    expect(defaults).toEqual({ a: 2, b: 3, nested: { x: 2, y: 2 } });\n  });\n\n  it(\"prevents prototype pollution via __proto__ and constructor\", () => {\n    const malicious = JSON.parse('{\"__proto__\": {\"polluted\": true}, \"constructor\": {\"polluted\": true}}');\n    const result = defu(malicious, { safe: true });\n\n    expect(result).toEqual({ safe: true });\n    expect(({} as any).polluted).toBeUndefined();\n  });\n});\n\ndescribe(\"createDefu\", () => {\n  it(\"uses custom merger and passes correct namespace\", () => {\n    const namespaces: string[] = [];\n    const customDefu = createDefu((obj, key, value, namespace) => {\n      namespaces.push(namespace ? `${namespace}.${key}` : key);\n      if (typeof obj[key] === \"number\" && typeof value === \"number\") {\n        obj[key] += value;\n        return true;\n      }\n    });\n\n    const result = customDefu(\n      { count: 5, nested: { score: 10 } },\n      { count: 3, nested: { score: 20, extra: 1 } },\n    );\n\n    expect(result).toEqual({ count: 8, nested: { score: 30, extra: 1 } });\n    expect(namespaces).toEqual([\"count\", \"nested\", \"nested.score\"]);\n  });\n});\n\ndescribe(\"defuFn\", () => {\n  it(\"calls function with default value when default is defined\", () => {\n    const result = defuFn(\n      {\n        count: (val: number) => val * 2,\n        items: (arr: string[]) => [...arr, \"c\"],\n      },\n      {\n        count: 5,\n        items: [\"a\", \"b\"],\n      },\n    );\n\n    expect(result).toEqual({\n      count: 10,\n      items: [\"a\", \"b\", \"c\"],\n    });\n  });\n\n  it(\"keeps function as-is when default is undefined\", () => {\n    const fn = () => \"hello\";\n    const result = defuFn({ fn }, {});\n    expect(result.fn).toBe(fn);\n  });\n});\n\ndescribe(\"defuArrayFn\", () => {\n  it(\"calls function only when default value is an array\", () => {\n    const nonArrayFn = (val: number) => val + 1;\n    const result = defuArrayFn(\n      {\n        items: (arr: number[]) => arr.filter((n) => n > 1),\n        count: nonArrayFn,\n      },\n      {\n        items: [1, 2, 3],\n        count: 10,\n      },\n    );\n\n    expect(result.items).toEqual([2, 3]);\n    expect(result.count).toBe(nonArrayFn);\n  });\n});\n"}},"projectRoot":"/home/runner/work/_temp/defu","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"coverageAnalysis":"perTest","mutate":["src/defu.ts"],"reporters":["json"],"jsonReporter":{"fileName":"/home/runner/work/mutation-guided-evals/mutation-guided-evals/runs/defu__defu__C1__r1/work/stryker-report.json"},"vitest":{"configFile":"vitest.eval.config.mjs","related":true,"pool":"threads"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"logLevel":"info","maxConcurrentTestRunners":9007199254740991,"maxTestRunnerReuse":0,"mutator":{"plugins":null,"excluded