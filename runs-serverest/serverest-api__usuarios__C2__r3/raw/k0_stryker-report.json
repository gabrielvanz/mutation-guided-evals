n  })\n}\n\nexports.schemaPost = {\n  body: Joi.object({\n    nome: Joi.string().required(),\n    email: Joi.string().email().required(),\n    password: Joi.string().required(),\n    administrador: Joi.any().valid('true', 'false').required()\n  })\n}\n\nexports.schemaDelete = {\n  params: Joi.object({\n    id: Joi.string().required()\n  })\n}\n\nexports.schemaPut = {\n  params: this.schemaDelete.params,\n  body: this.schemaPost.body\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/usuarios.gen.test.ts":{"tests":[{"id":"0","name":"usuarios API should get all usuarios","location":{"start":{"column":3,"line":6}}},{"id":"1","name":"usuarios API should get one usuario by id","location":{"start":{"column":3,"line":25}}},{"id":"2","name":"usuarios API should return 400 when usuario id is not found for getOne","location":{"start":{"column":3,"line":44}}},{"id":"3","name":"usuarios API should create a new usuario","location":{"start":{"column":3,"line":50}}},{"id":"4","name":"usuarios API should return 400 when creating a usuario with an existing email","location":{"start":{"column":3,"line":66}}},{"id":"5","name":"usuarios API should delete an existing usuario","location":{"start":{"column":3,"line":88}}},{"id":"6","name":"usuarios API should return delete none when deleting a non-existent usuario","location":{"start":{"column":3,"line":106}}},{"id":"7","name":"usuarios API should update an existing usuario using put","location":{"start":{"column":3,"line":112}}},{"id":"8","name":"usuarios API should create a usuario via put if id does not exist (upsert)","location":{"start":{"column":3,"line":139}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport request from \"supertest\";\nimport app from \"../../src/app\";\n\ndescribe(\"usuarios API\", () => {\n  it(\"should get all usuarios\", async () => {\n    const uniqueEmail = \"user_all@test.com\";\n    await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Test User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"true\"\n      });\n\n    const res = await request(app).get(\"/usuarios\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"quantidade\");\n    expect(res.body).toHaveProperty(\"usuarios\");\n    expect(Array.isArray(res.body.usuarios)).toBe(true);\n    expect(res.body.quantidade).toBeGreaterThan(0);\n  });\n\n  it(\"should get one usuario by id\", async () => {\n    const uniqueEmail = \"user_one@test.com\";\n    const postRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Single User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    const userId = postRes.body._id;\n\n    const res = await request(app).get(`/usuarios/${userId}`);\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"_id\", userId);\n    expect(res.body).toHaveProperty(\"email\", uniqueEmail);\n  });\n\n  it(\"should return 400 when usuario id is not found for getOne\", async () => {\n    const res = await request(app).get(\"/usuarios/1234567890abcdef\");\n    expect(res.status).toBe(400);\n    expect(res.body).toEqual({ message: \"Usuário não encontrado\" });\n  });\n\n  it(\"should create a new usuario\", async () => {\n    const uniqueEmail = \"new_user@test.com\";\n    const res = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"New User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"true\"\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body).toHaveProperty(\"message\", \"Cadastro realizado com sucesso\");\n    expect(res.body).toHaveProperty(\"_id\");\n  });\n\n  it(\"should return 400 when creating a usuario with an existing email\", async () => {\n    const uniqueEmail = \"duplicate@test.com\";\n    const userData = {\n      nome: \"User One\",\n      email: uniqueEmail,\n      password: \"password123\",\n      administrador: \"true\"\n    };\n\n    await request(app).post(\"/usuarios\").send(userData);\n\n    const res = await request(app).post(\"/usuarios\").send({\n      nome: \"User Two\",\n      email: uniqueEmail,\n      password: \"password456\",\n      administrador: \"false\"\n    });\n\n    expect(res.status).toBe(400);\n    expect(res.body).toEqual({ message: \"Este email já está sendo usado\" });\n  });\n\n  it(\"should delete an existing usuario\", async () => {\n    const uniqueEmail = \"delete_user@test.com\";\n    const postRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Delete User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    const userId = postRes.body._id;\n\n    const res = await request(app).delete(`/usuarios/${userId}`);\n    expect(res.status).toBe(200);\n    expect(res.body).toEqual({ message: \"Registro excluído com sucesso\" });\n  });\n\n  it(\"should return delete none when deleting a non-existent usuario\", async () => {\n    const res = await request(app).delete(\"/usuarios/nonexistentid12\");\n    expect(res.status).toBe(200);\n    expect(res.body).toEqual({ message: \"Nenhum registro excluído\" });\n  });\n\n  it(\"should update an existing usuario using put\", async () => {\n    const uniqueEmail = \"put_user@test.com\";\n    const postRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Put User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    const userId = postRes.body._id;\n    const updatedEmail = \"updated@test.com\";\n\n    const res = await request(app)\n      .put(`/usuarios/${userId}`)\n      .send({\n        nome: \"Updated Name\",\n        email: updatedEmail,\n        password: \"newpassword123\",\n        administrador: \"true\"\n      });\n\n    expect(res.status).toBe(200);\n    expect(res.body).toEqual({ message: \"Registro alterado com sucesso\" });\n  });\n\n  it(\"should create a usuario via put if id does not exist (upsert)\", async () => {\n    const uniqueEmail = \"upsert_user@test.com\";\n    const nonExistentId = \"abcdef1234567891\";\n\n    const res = await request(app)\n      .put(`/usuarios/${nonExistentId}`)\n      .send({\n        nome: \"Upserted User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body).toHaveProperty(\"message\", \"Cadastro realizado com sucesso\");\n    expect(res.body).toHaveProperty(\"_id\");\n  });\n});\n"}},"projectRoot":"/home/administrador/work/w2","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"vitest.eval.config.mjs","related":false,"pool":"threads"},"coverageAnalysis":"perTest","mutate":["src/controllers/usuarios-controller.js","src/services/usuarios-service.js","src/models/usuarios-model.js"],"reporters":["json"],"jsonReporter":{"fileName":"/home/administrador/mge/runs-serverest/serverest-api__usuarios__C2__r3/work/stryker-report.json"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false