1b[0m\n}\n\u001b[31m\n[1] \"value\" must have at least 1 key\u001b[0m","status":"RuntimeError","static":true,"coveredBy":[],"location":{"end":{"column":2,"line":41},"start":{"column":21,"line":38}}}],"source":"'use strict'\n\nconst { Joi } = require('express-validation')\n\nconst filtroDeTexto = require('../utils/filtroDeTexto')\n\nexports.schemaGet = {\n  query: Joi.object({\n    _id: filtroDeTexto,\n    nome: filtroDeTexto,\n    email: Joi.string().email(),\n    password: filtroDeTexto,\n    administrador: Joi.any().valid('true', 'false')\n  })\n}\n\nexports.schemaGetOne = {\n  params: Joi.object({\n    id: Joi.string().regex(/^[a-zA-Z0-9]{16}$/).required()\n  })\n}\n\nexports.schemaPost = {\n  body: Joi.object({\n    nome: Joi.string().required(),\n    email: Joi.string().email().required(),\n    password: Joi.string().required(),\n    administrador: Joi.any().valid('true', 'false').required()\n  })\n}\n\nexports.schemaDelete = {\n  params: Joi.object({\n    id: Joi.string().required()\n  })\n}\n\nexports.schemaPut = {\n  params: this.schemaDelete.params,\n  body: this.schemaPost.body\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/usuarios.gen.test.ts":{"tests":[{"id":"0","name":"Usuarios API should create a new user and retrieve it","location":{"start":{"column":3,"line":6}}},{"id":"1","name":"Usuarios API should prevent duplicate emails on creation","location":{"start":{"column":3,"line":27}}},{"id":"2","name":"Usuarios API should return all users","location":{"start":{"column":3,"line":46}}},{"id":"3","name":"Usuarios API should return 400 when user is not found by ID","location":{"start":{"column":3,"line":64}}},{"id":"4","name":"Usuarios API should update an existing user via PUT","location":{"start":{"column":3,"line":70}}},{"id":"5","name":"Usuarios API should delete an existing user","location":{"start":{"column":3,"line":98}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport request from \"supertest\";\nimport app from \"../../src/app\";\n\ndescribe(\"Usuarios API\", () => {\n  it(\"should create a new user and retrieve it\", async () => {\n    const postRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Test User\",\n        email: \"user_test_create@test.com\",\n        password: \"secretpassword\",\n        administrador: \"false\"\n      });\n\n    expect(postRes.status).toBe(201);\n    expect(postRes.body).toHaveProperty(\"_id\");\n\n    const userId = postRes.body._id;\n\n    const getRes = await request(app).get(`/usuarios/${userId}`);\n    expect(getRes.status).toBe(200);\n    expect(getRes.body).toHaveProperty(\"email\", \"user_test_create@test.com\");\n    expect(getRes.body).toHaveProperty(\"nome\", \"Test User\");\n  });\n\n  it(\"should prevent duplicate emails on creation\", async () => {\n    const userPayload = {\n      nome: \"User One\",\n      email: \"user_dup@test.com\",\n      password: \"password123\",\n      administrador: \"false\"\n    };\n\n    const firstRes = await request(app).post(\"/usuarios\").send(userPayload);\n    expect(firstRes.status).toBe(201);\n\n    const secondRes = await request(app).post(\"/usuarios\").send({\n      ...userPayload,\n      nome: \"User Two\"\n    });\n    expect(secondRes.status).toBe(400);\n    expect(secondRes.body).toHaveProperty(\"message\");\n  });\n\n  it(\"should return all users\", async () => {\n    await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"List User\",\n        email: \"user_list@test.com\",\n        password: \"password\",\n        administrador: \"true\"\n      });\n\n    const res = await request(app).get(\"/usuarios\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"quantidade\");\n    expect(res.body).toHaveProperty(\"usuarios\");\n    expect(Array.isArray(res.body.usuarios)).toBe(true);\n    expect(res.body.quantidade).toBeGreaterThan(0);\n  });\n\n  it(\"should return 400 when user is not found by ID\", async () => {\n    const res = await request(app).get(\"/usuarios/1234567890abcdef\");\n    expect(res.status).toBe(400);\n    expect(res.body).toHaveProperty(\"message\");\n  });\n\n  it(\"should update an existing user via PUT\", async () => {\n    const postRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Original Name\",\n        email: \"user_update@test.com\",\n        password: \"password\",\n        administrador: \"false\"\n      });\n\n    const userId = postRes.body._id;\n\n    const putRes = await request(app)\n      .put(`/usuarios/${userId}`)\n      .send({\n        nome: \"Updated Name\",\n        email: \"user_update@test.com\",\n        password: \"newpassword\",\n        administrador: \"true\"\n      });\n\n    expect([200, 201]).toContain(putRes.status);\n\n    const getRes = await request(app).get(`/usuarios/${userId}`);\n    expect(getRes.status).toBe(200);\n    expect(getRes.body.nome).toBe(\"Updated Name\");\n  });\n\n  it(\"should delete an existing user\", async () => {\n    const postRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Delete User\",\n        email: \"user_delete@test.com\",\n        password: \"password\",\n        administrador: \"false\"\n      });\n\n    const userId = postRes.body._id;\n\n    const deleteRes = await request(app).delete(`/usuarios/${userId}`);\n    expect(deleteRes.status).toBe(200);\n\n    const getRes = await request(app).get(`/usuarios/${userId}`);\n    expect(getRes.status).toBe(400);\n  });\n});\n"}},"projectRoot":"/home/administrador/work/w2","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"vitest.eval.config.mjs","related":false,"pool":"threads"},"coverageAnalysis":"perTest","mutate":["src/controllers/usuarios-controller.js","src/services/usuarios-service.js","src/models/usuarios-model.js"],"reporters":["json"],"jsonReporter":{"fileNam