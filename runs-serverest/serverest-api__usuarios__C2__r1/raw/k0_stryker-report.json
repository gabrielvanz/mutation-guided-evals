  \u001b[41m\"undefined\"\u001b[0m\u001b[31m [1]: -- missing --\u001b[0m\n}\n\u001b[31m\n[1] \"value\" must have at least 1 key\u001b[0m","status":"RuntimeError","static":true,"coveredBy":[],"location":{"end":{"column":2,"line":41},"start":{"column":21,"line":38}}},{"id":"57","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"expected 400 to be 201 // Object.is equality","status":"Killed","static":true,"testsCompleted":2,"duration":98.74849400000676,"killedBy":["1"],"coveredBy":[],"location":{"end":{"column":4,"line":35},"start":{"column":22,"line":33}}}],"source":"'use strict'\n\nconst { Joi } = require('express-validation')\n\nconst filtroDeTexto = require('../utils/filtroDeTexto')\n\nexports.schemaGet = {\n  query: Joi.object({\n    _id: filtroDeTexto,\n    nome: filtroDeTexto,\n    email: Joi.string().email(),\n    password: filtroDeTexto,\n    administrador: Joi.any().valid('true', 'false')\n  })\n}\n\nexports.schemaGetOne = {\n  params: Joi.object({\n    id: Joi.string().regex(/^[a-zA-Z0-9]{16}$/).required()\n  })\n}\n\nexports.schemaPost = {\n  body: Joi.object({\n    nome: Joi.string().required(),\n    email: Joi.string().email().required(),\n    password: Joi.string().required(),\n    administrador: Joi.any().valid('true', 'false').required()\n  })\n}\n\nexports.schemaDelete = {\n  params: Joi.object({\n    id: Joi.string().required()\n  })\n}\n\nexports.schemaPut = {\n  params: this.schemaDelete.params,\n  body: this.schemaPost.body\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/usuarios.gen.test.ts":{"tests":[{"id":"0","name":"Usuarios API should get empty or list of users","location":{"start":{"column":3,"line":6}}},{"id":"1","name":"Usuarios API should create a new user successfully","location":{"start":{"column":3,"line":14}}},{"id":"2","name":"Usuarios API should not allow creating a user with an existing email","location":{"start":{"column":3,"line":29}}},{"id":"3","name":"Usuarios API should return 400 when user is not found by id","location":{"start":{"column":3,"line":49}}},{"id":"4","name":"Usuarios API should get a specific user by id","location":{"start":{"column":3,"line":55}}},{"id":"5","name":"Usuarios API should delete an existing user","location":{"start":{"column":3,"line":75}}},{"id":"6","name":"Usuarios API should update an existing user with PUT or create if not exists","location":{"start":{"column":3,"line":92}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport request from \"supertest\";\nimport app from \"../../src/app\";\n\ndescribe(\"Usuarios API\", () => {\n  it(\"should get empty or list of users\", async () => {\n    const res = await request(app).get(\"/usuarios\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"quantidade\");\n    expect(res.body).toHaveProperty(\"usuarios\");\n    expect(Array.isArray(res.body.usuarios)).toBe(true);\n  });\n\n  it(\"should create a new user successfully\", async () => {\n    const res = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Test User\",\n        email: \"user_test_unique_01@test.com\",\n        password: \"123\",\n        administrador: \"true\"\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body.message).toBe(\"Cadastro realizado com sucesso\");\n    expect(res.body).toHaveProperty(\"_id\");\n  });\n\n  it(\"should not allow creating a user with an existing email\", async () => {\n    const payload = {\n      nome: \"User One\",\n      email: \"user_dup_unique_02@test.com\",\n      password: \"123\",\n      administrador: \"false\"\n    };\n\n    const firstRes = await request(app).post(\"/usuarios\").send(payload);\n    expect(firstRes.status).toBe(201);\n\n    const secondRes = await request(app).post(\"/usuarios\").send({\n      ...payload,\n      nome: \"User Two\"\n    });\n\n    expect(secondRes.status).toBe(400);\n    expect(secondRes.body.message).toBe(\"Este email já está sendo usado\");\n  });\n\n  it(\"should return 400 when user is not found by id\", async () => {\n    const res = await request(app).get(\"/usuarios/1234567890abcdef\");\n    expect(res.status).toBe(400);\n    expect(res.body.message).toBe(\"Usuário não encontrado\");\n  });\n\n  it(\"should get a specific user by id\", async () => {\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Find Me\",\n        email: \"getone_unique_03@test.com\",\n        password: \"123\",\n        administrador: \"false\"\n      });\n\n    expect(createRes.status).toBe(201);\n    const userId = createRes.body._id;\n\n    const res = await request(app).get(`/usuarios/${userId}`);\n    expect(res.status).toBe(200);\n    expect(res.body._id).toBe(userId);\n    expect(res.body.nome).toBe(\"Find Me\");\n    expect(res.body.email).toBe(\"getone_unique_03@test.com\");\n  });\n\n  it(\"should delete an existing user\", async () => {\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Delete Me\",\n        email: \"del_unique_04@test.com\",\n        password: \"123\",\n        administrador: \"false\"\n      });\n\n    const userId = createRes.body._id;\n\n    const res = await request(app).delete(`/usuarios/${userId}`);\n    expect(res.status).toBe(200);\n    expect(res.body.message).toBe(\"Registro excluído com sucesso\");\n  });\n\n  it(\"should update an existing user with PUT or create if not exists\", async () => {\n    const fakeId = \"9999999999999999\";\n\n    const res = await request(app)\n      .put(`/usuarios/${fakeId}`)\n      .send({\n        nome: \"Put User\",\n        email: \"put_unique_05@test.com\",\n        password: \"123\",\n        administrador: \"true\"\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body.message).toBe(\"Cadastro realizado com sucesso\");\n    expect(res.body).toHaveProperty(\"_id\");\n    expect(typeof res.body._id).toBe(\"string\");\n  });\n});\n"}},"projectRoot":"/home/administrador/work/w1","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"vitest.eval.config.mjs","related":false,"pool":"threads"},"coverageAnalysis":"perTest","mutate":["src/controllers/usuarios-controller.js","src/services/usuarios-service.js","src/models/usuarios-model.js"],"reporters":["json"],"jsonReporter":{"fileName":"/home/administrador/mge/runs-serverest/serverest-api__usuarios__C2__r1/work/stryker-report.json"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"logLevel":"info","maxConcurrentTestRunners":9007199254740991,"maxTestRunnerReuse":0,"mutator":{"plugins":null,"excludedMutations":[]},"appendPlugins":[],"htmlReporter":{"fileName":"reports/mutation/mutation.html"},"symlinkNodeModules":true,"tempDirName":".stryker-tmp","testRunnerNodeArgs":[],"thresholds":{"high":80,"low":60,"break":null},"dryRunTimeoutMinutes":5,"tsconfigFile":"tsconfig.json","warnings":true,"disableBail":false,"allowEmpty":false,"ignorers":[],"testFiles":[]},"framework":{"name":"StrykerJS","version":"10.1.1","branding":{"homepageUrl":"https://stryker-mutator.io","imageUrl":"data:image/svg+xml;utf8,%3Csvg viewBox='0 0 1458 1458' xmlns='http://www.w3.org/2000/svg' fill-rule='evenodd' clip-rule='evenodd' str