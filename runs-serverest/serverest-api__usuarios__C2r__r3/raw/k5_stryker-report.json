g = alterarValoresParaRegex(queryString)\r\n  return doMaisNovoAoMaisAntigo(await datastore.find(queryString))\r\n}\r\n\r\nexports.getOne = async id => {\r\n  return semMarca(await datastore.findOne({ _id: id }))\r\n}\r\n\r\nexports.getDadosDoUsuario = queryString => {\r\n  return datastore.findOne(queryString)\r\n}\r\n\r\nexports.existeUsuario = async pesquisa => {\r\n  return datastore.findOne(pesquisa)\r\n}\r\n\r\nexports.usuarioEhAdministrador = async ({ email, password }) => {\r\n  const resultado = await datastore.findOne({ email, password })\r\n  return JSON.parse(resultado.administrador)\r\n}\r\n\r\nexports.createUser = async body => {\r\n  return datastore.insert({ ...body, alteradoEm: marcarAlteracao() })\r\n}\r\n\r\nexports.deleteById = async id => {\r\n  return datastore.remove({ _id: id }, {})\r\n}\r\n\r\nexports.createOrUpdateById = async (idDoUsuarioQueSeraAlterado, body) => {\r\n  return datastore.update({ _id: idDoUsuarioQueSeraAlterado }, { ...body, alteradoEm: marcarAlteracao() }, { upsert: true, returnUpdatedDocs: true })\r\n}\r\n"},"src/models/usuarios-model.js":{"language":"javascript","mutants":[{"id":"42","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"An error occurred outside of a test run: /home/administrador/work/w1/.stryker-tmp/sandbox-5TSYPm/test/__generated__/usuarios.gen.test.ts: Cannot read properties of undefined (reading 'describe')","status":"RuntimeError","static":true,"coveredBy":[],"location":{"end":{"column":2,"line":15},"start":{"column":21,"line":7}}},{"id":"43","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"expected 400 to be 201 // Object.is equality","status":"Killed","static":true,"testsCompleted":2,"duration":85.11135800000193,"killedBy":["1"],"coveredBy":[],"location":{"end":{"column":4,"line":14},"start":{"column":21,"line":8}}},{"id":"44","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected 400 to be 201 // Object.is equality","status":"Killed","static":true,"