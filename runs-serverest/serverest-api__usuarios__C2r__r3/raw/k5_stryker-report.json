:"{}","statusReason":"An error occurred outside of a test run: /home/administrador/work/w1/.stryker-tmp/sandbox-5TSYPm/test/__generated__/usuarios.gen.test.ts: {\n  \u001b[41m\"undefined\"\u001b[0m\u001b[31m [1]: -- missing --\u001b[0m\n}\n\u001b[31m\n[1] \"value\" must have at least 1 key\u001b[0m","status":"RuntimeError","static":true,"coveredBy":[],"location":{"end":{"column":2,"line":36},"start":{"column":24,"line":32}}},{"id":"58","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"An error occurred outside of a test run: /home/administrador/work/w1/.stryker-tmp/sandbox-5TSYPm/test/__generated__/usuarios.gen.test.ts: {\n  \u001b[41m\"undefined\"\u001b[0m\u001b[31m [1]: -- missing --\u001b[0m\n}\n\u001b[31m\n[1] \"value\" must have at least 1 key\u001b[0m","status":"RuntimeError","static":true,"coveredBy":[],"location":{"end":{"column":2,"line":41},"start":{"column":21,"line":38}}},{"id":"57","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"expected 400 to be 201 // Object.is equality","status":"Killed","static":true,"testsCompleted":2,"duration":88.29026100000192,"killedBy":["1"],"coveredBy":[],"location":{"end":{"column":4,"line":35},"start":{"column":22,"line":33}}}],"source":"'use strict'\n\nconst { Joi } = require('express-validation')\n\nconst filtroDeTexto = require('../utils/filtroDeTexto')\n\nexports.schemaGet = {\n  query: Joi.object({\n    _id: filtroDeTexto,\n    nome: filtroDeTexto,\n    email: Joi.string().email(),\n    password: filtroDeTexto,\n    administrador: Joi.any().valid('true', 'false')\n  })\n}\n\nexports.schemaGetOne = {\n  params: Joi.object({\n    id: Joi.string().regex(/^[a-zA-Z0-9]{16}$/).required()\n  })\n}\n\nexports.schemaPost = {\n  body: Joi.object({\n    nome: Joi.string().required(),\n    email: Joi.string().email().required(),\n    password: Joi.string().required(),\n    administrador: Joi.any().valid('true', 'false').required()\n  })\n}\n\nexports.schemaDelete = {\n  params: Joi.object({\n    id: Joi.string().required()\n  })\n}\n\nexports.schemaPut = {\n  params: this.schemaDelete.params,\n  body: this.schemaPost.body\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/usuarios.gen.test.ts":{"tests":[{"id":"0","name":"Usuarios API should get all users","location":{"start":{"column":3,"line":6}}},{"id":"1","name":"Usuarios API should filter users by query parameters","location":{"start":{"column":3,"line":14}}},{"id":"2","name":"Usuarios API should create a new user successfully","location":{"start":{"column":3,"line":35}}},{"id":"3","name":"Usuarios API should not create a user with an already used email","location":{"start":{"column":3,"line":51}}},{"id":"4","name":"Usuarios API should get a single user by valid id","location":{"start":{"column":3,"line":68}}},{"id":"5","name":"Usuarios API should return 400 when getting a non-existent user id with correct format","location":{"start":{"column":3,"line":88}}},{"id":"6","name":"Usuarios API should return validation error when getting user with invalid id format","location":{"start":{"column":3,"line":94}}},{"id":"7","name":"Usuarios API should delete an existing user","location":{"start":{"column":3,"line":99}}},{"id":"8","name":"Usuarios API should return delete none message when deleting non-existent user","location":{"start":{"column":3,"line":118}}},{"id":"9","name":"Usuarios API should update an existing user via PUT","location":{"start":{"column":3,"line":124}}},{"id":"10","name":"Usuarios API should upsert a user via PUT if id does not exist","location":{"start":{"column":3,"line":151}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport request from \"supertest\";\nimport app from \"../../src/app\";\n\ndescribe(\"Usuarios API\", () => {\n  it(\"should get all users\", async () => {\n    const res = await request(app).get(\"/usuarios\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"quantidade\");\n    expect(res.body).toHaveProperty(\"usuarios\");\n    expect(Array.isArray(res.body.usuarios)).toBe(true);\n  });\n\n  it(\"should filter users by query parameters\", async () => {\n    const uniqueName = \"UserTest_Filter\";\n    const uniqueEmail = \"usertest_filter@qa.com\";\n\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: uniqueName,\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    expect(createRes.status).toBe(201);\n\n    const res = await request(app).get(`/usuarios?nome=${uniqueName}`);\n    expect(res.status).toBe(200);\n    expect(res.body.quantidade).toBe(1);\n    expect(res.body.usuarios[0].nome).toBe(uniqueName);\n  });\n\n  it(\"should create a new user successfully\", async () => {\n    const uniqueEmail = \"newuser_success@qa.com\";\n    const res = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Fulano da Silva\",\n        email: uniqueEmail,\n        password: \"teste\",\n        administrador: \"true\"\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body.message).toBe(\"Cadastro realizado com sucesso\");\n    expect(res.body).toHaveProperty(\"_id\");\n  });\n\n  it(\"should not create a user with an already used email\", async () => {\n    const uniqueEmail = \"duplicate_email@qa.com\";\n    const payload = {\n      nome: \"Fulano da Silva\",\n      email: uniqueEmail,\n      password: \"teste\",\n      administrador: \"true\"\n    };\n\n    const firstRes = await request(app).post(\"/usuarios\").send(payload);\n    expect(firstRes.status).toBe(201);\n\n    const secondRes = await request(app).post(\"/usuarios\").send(payload);\n    expect(secondRes.status).toBe(400);\n    expect(secondRes.body.message).toBe(\"Este email já está sendo usado\");\n  });\n\n  it(\"should get a single user by valid id\", async () => {\n    const uniqueEmail = \"getone_user@qa.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Test Get One\",\n        email: uniqueEmail,\n        password: \"123\",\n        administrador: \"false\"\n      });\n\n    expect(createRes.status).toBe(201);\n    const userId = createRes.body._id;\n\n    const res = await request(app).get(`/usuarios/${userId}`);\n    expect(res.status).toBe(200);\n    expect(res.body._id).toBe(userId);\n    expect(res.body.email).toBe(uniqueEmail);\n  });\n\n  it(\"should return 400 when getting a non-existent user id with correct format\", async () => {\n    const res = await request(app).get(\"/usuarios/1234567890abcdef\");\n    expect(res.status).toBe(400);\n    expect(res.body.message).toBe(\"Usuário não encontrado\");\n  });\n\n  it(\"should return validation error when getting user with invalid id format\", async () => {\n    const res = await request(app).get(\"/usuarios/invalid-id\");\n    expect(res.status).toBe(400);\n  });\n\n  it(\"should delete an existing user\", async () => {\n    const uniqueEmail = \"delete_user@qa.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"To Delete\",\n        email: uniqueEmail,\n        password: \"123\",\n        administrador: \"false\"\n      });\n\n    expect(createRes.status).toBe(201);\n    const userId = createRes.body._id;\n\n    const deleteRes = await request(app).delete(`/usuarios/${userId}`);\n    expect(deleteRes.status).toBe(200);\n    expect(deleteRes.body.message).toBe(\"Registro excluído com sucesso\");\n  });\n\n  it(\"should return delete none message when deleting non-existent user\", async () => {\n    const deleteRes = await request(app).delete(\"/usuarios/nonexistentid12\");\n    expect(deleteRes.status).toBe(200);\n    expect(deleteRes.body.message).toBe(\"Nenhum registro excluído\");\n  });\n\n  it(\"should update an existing user via PUT\", async () => {\n    const uniqueEmail = \"put_user@qa.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Before Update\",\n        email: uniqueEmail,\n        password: \"123\",\n        administrador: \"false\"\n      });\n\n    expect(createRes.status).toBe(201);\n    const userId = createRes.body._id;\n\n    const putRes = await request(app)\n      .put(`/usuarios/${userId}`)\n      .send({\n        nome: \"After Update\",\n        email: uniqueEmail,\n        password: \"456\",\n        administrador: \"true\"\n      });\n\n    expect(putRes.status).toBe(200);\n    expect(putRes.body.message).toBe(\"Registro alterado com sucesso\");\n  });\n\n  it(\"should upsert a user via PUT if id does not exist\", async () => {\n    const uniqueEmail = \"upsert_user@qa.com\";\n    const randomId = \"abc1234567890xyz\";\n\n    const putRes = await request(app)\n      .put(`/usuarios/${randomId}`)\n      .send({\n        nome: \"Upserted User\",\n        email: uniqueEmail,\n        password: \"123\",\n        administrador: \"false\"\n      });\n\n    expect(putRes.status).toBe(201);\n    expect(putRes.body.message).toBe(\"Cadastro realizado com sucesso\");\n    expect(putRes.body).toHaveProperty(\"_id\");\n  });\n});\n"}},"projectRoot":"/home/administrador/work/w1","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"vitest.eval.config.mjs","related":false,"pool":"threads"},"coverageAnalysis":"perTest","mutate":["src/controllers/usuarios-controller.js","src/services/usuarios-service.js","src/models/usuarios-model.js"],"reporters":["json"],"jsonReporter":{"fileName":"/home/administrador/mge/runs-serverest/serverest-api__usuarios__C2r__r3/work/stryker-report.json"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowCol