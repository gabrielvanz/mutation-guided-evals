"testFiles":{"test/__generated__/usuarios.gen.test.ts":{"tests":[{"id":"0","name":"Usuarios API should get all usuarios successfully","location":{"start":{"column":3,"line":6}}},{"id":"1","name":"Usuarios API should filter usuarios by query parameters","location":{"start":{"column":3,"line":14}}},{"id":"2","name":"Usuarios API should return 400 when getting a usuario with invalid id format","location":{"start":{"column":3,"line":35}}},{"id":"3","name":"Usuarios API should return 400 when usuario is not found","location":{"start":{"column":3,"line":40}}},{"id":"4","name":"Usuarios API should create a new usuario successfully","location":{"start":{"column":3,"line":46}}},{"id":"5","name":"Usuarios API should return 400 when creating a usuario with an existing email","location":{"start":{"column":3,"line":62}}},{"id":"6","name":"Usuarios API should return 400 when required fields are missing on post","location":{"start":{"column":3,"line":79}}},{"id":"7","name":"Usuarios API should delete an existing usuario successfully","location":{"start":{"column":3,"line":89}}},{"id":"8","name":"Usuarios API should return DELETE_NONE when deleting a non-existent usuario id","location":{"start":{"column":3,"line":108}}},{"id":"9","name":"Usuarios API should update an existing usuario successfully (PUT)","location":{"start":{"column":3,"line":114}}},{"id":"10","name":"Usuarios API should upsert/create via PUT if usuario does not exist","location":{"start":{"column":3,"line":141}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport request from \"supertest\";\nimport app from \"../../src/app\";\n\ndescribe(\"Usuarios API\", () => {\n  it(\"should get all usuarios successfully\", async () => {\n    const res = await request(app).get(\"/usuarios\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"quantidade\");\n    expect(res.body).toHaveProperty(\"usuarios\");\n    expect(Array.isArray(res.body.usuarios)).toBe(true);\n  });\n\n  it(\"should filter usuarios by query parameters\", async () => {\n    const uniqueEmail = \"user_filter_abc@test.com\";\n    const uniqueName = \"User Filter Test\";\n\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: uniqueName,\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"true\"\n      });\n\n    expect(createRes.status).toBe(201);\n\n    const res = await request(app).get(`/usuarios?email=${uniqueEmail}`);\n    expect(res.status).toBe(200);\n    expect(res.body.quantidade).toBe(1);\n    expect(res.body.usuarios[0].email).toBe(uniqueEmail);\n  });\n\n  it(\"should return 400 when getting a usuario with invalid id format\", async () => {\n    const res = await request(app).get(\"/usuarios/invalid-id\");\n    expect(res.status).toBe(400);\n  });\n\n  it(\"should return 400 when usuario is not found\", async () => {\n    const res = await request(app).get(\"/usuarios/1234567890abcdef\");\n    expect(res.status).toBe(400);\n    expect(res.body).toEqual({ message: \"Usuário não encontrado\" });\n  });\n\n  it(\"should create a new usuario successfully\", async () => {\n    const uniqueEmail = \"create_user_abc@test.com\";\n    const res = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Test User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body).toHaveProperty(\"message\", \"Cadastro realizado com sucesso\");\n    expect(res.body).toHaveProperty(\"_id\");\n  });\n\n  it(\"should return 400 when creating a usuario with an existing email\", async () => {\n    const uniqueEmail = \"duplicate_user_abc@test.com\";\n    const payload = {\n      nome: \"Test User\",\n      email: uniqueEmail,\n      password: \"password123\",\n      administrador: \"false\"\n    };\n\n    const firstRes = await request(app).post(\"/usuarios\").send(payload);\n    expect(firstRes.status).toBe(201);\n\n    const secondRes = await request(app).post(\"/usuarios\").send(payload);\n    expect(secondRes.status).toBe(400);\n    expect(secondRes.body).toEqual({ message: \"Este email já está sendo usado\" });\n  });\n\n  it(\"should return 400 when required fields are missing on post\", async () => {\n    const res = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Incomplete User\"\n      });\n\n    expect(res.status).toBe(400);\n  });\n\n  it(\"should delete an existing usuario successfully\", async () => {\n    const uniqueEmail = \"delete_user_abc@test.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Delete User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    expect(createRes.status).toBe(201);\n    const userId = createRes.body._id;\n\n    const deleteRes = await request(app).delete(`/usuarios/${userId}`);\n    expect(deleteRes.status).toBe(200);\n    expect(deleteRes.body).toEqual({ message: \"Registro excluído com sucesso\" });\n  });\n\n  it(\"should return DELETE_NONE when deleting a non-existent usuario id\", async () => {\n    const deleteRes = await request(app).delete(\"/usuarios/nonexistentid123\");\n    expect(deleteRes.status).toBe(200);\n    expect(deleteRes.body).toEqual({ message: \"Nenhum registro excluído\" });\n  });\n\n  it(\"should update an existing usuario successfully (PUT)\", async () => {\n    const uniqueEmail = \"put_user_abc@test.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Put User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    expect(createRes.status).toBe(201);\n    const userId = createRes.body._id;\n\n    const updateRes = await request(app)\n      .put(`/usuarios/${userId}`)\n      .send({\n        nome: \"Updated Put User\",\n        email: uniqueEmail,\n        password: \"newpassword\",\n        administrador: \"true\"\n      });\n\n    expect(updateRes.status).toBe(200);\n    expect(updateRes.body).toEqual({ message: \"Registro alterado com sucesso\" });\n  });\n\n  it(\"should upsert/create via PUT if usuario does not exist\", async () => {\n    const uniqueEmail = \"upsert_user_abc@test.com\";\n    const nonExistentId = \"abcdef0123456789\";\n\n    const updateRes = await request(app)\n      .put(`/usuarios/${nonExistentId}`)\n      .send({\n        nome: \"Upserted User\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    expect(updateRes.status).toBe(201);\n    expect(updateRes.body).toHaveProperty(\"message\", \"Cadastro realizado com sucesso\");\n    expect(updateRes.body).toHaveProperty(\"_id\");\n  });\n});\n"}},"projectRoot":"/home/administrador/work/w2","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"vitest.eval.config.mjs","related":false,"pool":"threads"},"coverageAnalysis":"perTest","mutate":["src/controllers/usuarios-controller.js","src/services/usuarios-service.js","src/models/usuarios-model.js"],"reporters":["json"],"jsonReporter":{"fileName":"/home/administrador/mge/runs-serverest/serverest-api__usuarios__C2r__r2/work/stryker-report.json"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/ev