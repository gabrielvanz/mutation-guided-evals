rvices/carrinhos-service')\r\nconst constant = require('../utils/constants')\r\nconst service = require('../services/usuarios-service')\r\n\r\nexports.get = async (req, res) => {\r\n  const usuarios = await service.getAll(req.query)\r\n  res.status(200).send({ quantidade: usuarios.length, usuarios })\r\n}\r\n\r\nexports.getOne = async (req, res) => {\r\n  const { id } = req.params\r\n  const usuario = await service.getOne(id)\r\n  if (!usuario) {\r\n    return res.status(400).json({ message: constant.USER_NOT_FOUND })\r\n  }\r\n  return res.status(200).send(usuario)\r\n}\r\n\r\nexports.post = async (req, res) => {\r\n  if (await service.existeUsuario({ email: req.body.email })) {\r\n    return res.status(400).send({ message: constant.EMAIL_ALREADY_USED })\r\n  }\r\n  const dadosCadastrados = await service.createUser(req.body)\r\n  res.status(201).send({ message: constant.POST_SUCCESS, _id: dadosCadastrados._id })\r\n}\r\n\r\nexports.delete = async (req, res) => {\r\n  const carrinhoDoUsuario = await carrinhosService.existeCarrinho({ idUsuario: req.params.id })\r\n  if (carrinhoDoUsuario) {\r\n    return res.status(400).send({ message: constant.DELETE_USER_WITH_CART, idCarrinho: carrinhoDoUsuario._id })\r\n  }\r\n  const quantidadeRegistrosExcluidos = await service.deleteById(req.params.id)\r\n  const message = quantidadeRegistrosExcluidos === 0 ? constant.DELETE_NONE : constant.DELETE_SUCCESS\r\n  res.status(200).send({ message })\r\n}\r\n\r\nexports.put = async (req, res) => {\r\n  const idInexistenteEEmailRepetido = await service.existeUsuario({ email: req.body.email, $not: { _id: req.params.id } })\r\n  if (idInexistenteEEmailRepetido) {\r\n    return res.status(400).send({ message: constant.EMAIL_ALREADY_USED })\r\n  }\r\n  const registroCriado = await service.createOrUpdateById(req.params.id, req.body)\r\n  if (registroCriado._id !== req.params.id) { return res.status(201).send({ message: constant.POST_SUCCESS, _id: registroCriado._id }) }\r\n  res.status(200).send({ message: constant.PUT_SUCCESS })\r\n}\r\n"},"src/services/usuarios-service.js":{"language":"javascript","mutants":[{"id":"70","mutatorName":"BlockStatement","replacement":"{}","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":2,"line":27},"start":{"column":44,"line":25}}},{"id":"72","mutatorName":"BlockStatement","replacement":"{}","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":2,"line":36},"start":{"column":65,"line":33}}},{"id":"73","mutatorName":"ObjectLiteral","replacement":"{}","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":64,"line":34},"start":{"column":45,"line":34}}},{"id":"67","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected 500 to be 200 // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":32.1977939999997,"killedBy":["0"],"coveredBy":["0","1"],"location":{"end":{"column":2,"line":19},"start":{"column":39,"line":16}}},{"id":"68","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected 400 to be 200 // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":253.1829629999993,"killedBy":["6"],"coveredBy":["6","7"],"location":{"end":{"column":2,"line":23},"start":{"column":30,"line":21}}},{"id":"69","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"expected 400 to be 200 // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":251.90966499999922,"killedBy":["6"],"coveredBy":["6","7"],"location":{"end":{"column":54,"line":22},"start":{"column":43,"line":22}}},{"id":"71","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected 3 to be 1 // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":247.66924600000493,"killedBy":["1"],"coveredBy":["1","3","4","6","8","10"],"location":{"end":{"column":2,"line":31},"start":{"column":43,"line":29}}},{"id":"74","mutatorName":"Bl