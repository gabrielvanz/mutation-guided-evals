alid('true', 'false').required()\n  })\n}\n\nexports.schemaDelete = {\n  params: Joi.object({\n    id: Joi.string().required()\n  })\n}\n\nexports.schemaPut = {\n  params: this.schemaDelete.params,\n  body: this.schemaPost.body\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/__generated__/usuarios.gen.test.ts":{"tests":[{"id":"0","name":"usuarios API should get all users","location":{"start":{"column":3,"line":6}}},{"id":"1","name":"usuarios API should filter users by query parameters","location":{"start":{"column":3,"line":14}}},{"id":"2","name":"usuarios API should return 400 for invalid query parameters","location":{"start":{"column":3,"line":33}}},{"id":"3","name":"usuarios API should create a new user successfully","location":{"start":{"column":3,"line":38}}},{"id":"4","name":"usuarios API should not create a user with an existing email","location":{"start":{"column":3,"line":54}}},{"id":"5","name":"usuarios API should return validation error when posting incomplete user data","location":{"start":{"column":3,"line":71}}},{"id":"6","name":"usuarios API should get one user by id","location":{"start":{"column":3,"line":81}}},{"id":"7","name":"usuarios API should return 400 when user is not found by id","location":{"start":{"column":3,"line":100}}},{"id":"8","name":"usuarios API should delete an existing user","location":{"start":{"column":3,"line":107}}},{"id":"9","name":"usuarios API should return deletion none message when user does not exist on delete","location":{"start":{"column":3,"line":125}}},{"id":"10","name":"usuarios API should update an existing user via PUT or create if not exists","location":{"start":{"column":3,"line":132}}}],"source":"import { describe, it, expect } from \"vitest\";\nimport request from \"supertest\";\nimport app from \"../../src/app\";\n\ndescribe(\"usuarios API\", () => {\n  it(\"should get all users\", async () => {\n    const res = await request(app).get(\"/usuarios\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"quantidade\");\n    expect(res.body).toHaveProperty(\"usuarios\");\n    expect(Array.isArray(res.body.usuarios)).toBe(true);\n  });\n\n  it(\"should filter users by query parameters\", async () => {\n    const uniqueEmail = \"user_filter@test.com\";\n    const uniqueName = \"User Filter\";\n\n    await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: uniqueName,\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"true\"\n      });\n\n    const res = await request(app).get(`/usuarios?email=${uniqueEmail}`);\n    expect(res.status).toBe(200);\n    expect(res.body.quantidade).toBe(1);\n    expect(res.body.usuarios[0].email).toBe(uniqueEmail);\n  });\n\n  it(\"should return 400 for invalid query parameters\", async () => {\n    const res = await request(app).get(\"/usuarios?email=invalid-email\");\n    expect(res.status).toBe(400);\n  });\n\n  it(\"should create a new user successfully\", async () => {\n    const uniqueEmail = \"new_user@test.com\";\n    const res = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Novo Usuario\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body).toHaveProperty(\"message\", \"Cadastro realizado com sucesso\");\n    expect(res.body).toHaveProperty(\"_id\");\n  });\n\n  it(\"should not create a user with an existing email\", async () => {\n    const uniqueEmail = \"dup_user@test.com\";\n    const payload = {\n      nome: \"Usuario Duplicado\",\n      email: uniqueEmail,\n      password: \"password123\",\n      administrador: \"false\"\n    };\n\n    const firstRes = await request(app).post(\"/usuarios\").send(payload);\n    expect(firstRes.status).toBe(201);\n\n    const secondRes = await request(app).post(\"/usuarios\").send(payload);\n    expect(secondRes.status).toBe(400);\n    expect(secondRes.body).toHaveProperty(\"message\", \"Este email já está sendo usado\");\n  });\n\n  it(\"should return validation error when posting incomplete user data\", async () => {\n    const res = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Incompleto\"\n      });\n\n    expect(res.status).toBe(400);\n  });\n\n  it(\"should get one user by id\", async () => {\n    const uniqueEmail = \"getone_user@test.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Get One\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    const userId = createRes.body._id;\n\n    const res = await request(app).get(`/usuarios/${userId}`);\n    expect(res.status).toBe(200);\n    expect(res.body._id).toBe(userId);\n    expect(res.body.email).toBe(uniqueEmail);\n  });\n\n  it(\"should return 400 when user is not found by id\", async () => {\n    const fakeId = \"1234567890abcdef\";\n    const res = await request(app).get(`/usuarios/${fakeId}`);\n    expect(res.status).toBe(400);\n    expect(res.body).toHaveProperty(\"message\", \"Usuário não encontrado\");\n  });\n\n  it(\"should delete an existing user\", async () => {\n    const uniqueEmail = \"del_user@test.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Para Deletar\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    const userId = createRes.body._id;\n\n    const res = await request(app).delete(`/usuarios/${userId}`);\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"message\", \"Registro excluído com sucesso\");\n  });\n\n  it(\"should return deletion none message when user does not exist on delete\", async () => {\n    const fakeId = \"abcdef1234567890\";\n    const res = await request(app).delete(`/usuarios/${fakeId}`);\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"message\", \"Nenhum registro excluído\");\n  });\n\n  it(\"should update an existing user via PUT or create if not exists\", async () => {\n    const uniqueEmail = \"put_user@test.com\";\n    const createRes = await request(app)\n      .post(\"/usuarios\")\n      .send({\n        nome: \"Usuario Put\",\n        email: uniqueEmail,\n        password: \"password123\",\n        administrador: \"false\"\n      });\n\n    const userId = createRes.body._id;\n    const updatedEmail = \"updated_user@test.com\";\n\n    const res = await request(app)\n      .put(`/usuarios/${userId}`)\n      .send({\n        nome: \"Usuario Atualizado\",\n        email: updatedEmail,\n        password: \"password456\",\n        administrador: \"true\"\n      });\n\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty(\"message\", \"Registro alterado com sucesso\");\n  });\n});\n"}},"projectRoot":"/home/administrador/work/w2","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"vitest.eval.config.mjs","related":false,"pool":"threads"},"coverageAnalysis":"perTest","mutate":["src/controllers/usuarios-controller.js","src/services/usuarios-service.js","src/models/usuarios-model.js"],"reporters":["json"],"jsonReporter":{"fileName":"/home/administrador/mge/runs-serverest/serverest-api__usuarios__C2r__r2/work/stryker-report.json"},"concurrency":2,"timeoutMS":10000,"timeoutFactor":1.5,"disableTypeChecks":true,"incremental":false,"cleanTempDir":true,"configFile":"stryker.eval.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRu